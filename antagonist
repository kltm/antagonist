# ------------------------------------------------------------------- probes

def probe(backend, cfg, model=None):
    """Cheap candidacy check: binary present / key file present / model named.
    No model calls, so "ok" means configured, not proven reachable."""
    b = dict(cfg.get(backend, {}))
    if model:
        b["model"] = model
    if backend in CLI_BACKENDS:
        exe, on_path = find_binary(backend)
        if not exe:
            return False, "binary not on PATH nor in fallback dirs"
        note = exe if on_path else f"{exe} (not on PATH; fallback)"
        if backend == "agy":
            st = read_json(os.path.join(HOME, ".gemini/antigravity-cli/settings.json"), {})
            grants = [g for g in (st.get("permissions") or {}).get("allow", [])
                      if g.startswith("read_file(")]
            note += f"; read grants: {', '.join(grants) or 'NONE (use agy-allow)'}"
        return True, note
    if backend in ("anthropic", "moonshot"):
        kf = b.get("key_file")
        env = {"anthropic": "ANTHROPIC_API_KEY", "moonshot": "MOONSHOT_API_KEY"}[backend]
        if kf and os.path.exists(kf):
            return True, f"key file {kf}"
        if os.environ.get(env):
            return True, f"${env}"
        return False, f"no key file ({kf}) and ${env} unset"
    if backend == "local":
        if not (b.get("model") or "").strip():
            return False, f"{b.get('base_url')}: no model configured"
        try:
            urllib.request.urlopen(f"{b['base_url'].rstrip('/')}/models", timeout=3)
            return True, f"{b['base_url']} answers /models"
        except Exception as exc:  # noqa: BLE001
            return True, f"{b['base_url']}: /models probe failed ({exc.__class__.__name__}); will try anyway"
    return False, "unknown backend"


# ----------------------------------------------------------------- preflight
# Currency check: is each CLI harness at its latest release, and is each
# pinned model the newest of its family in the backend's own catalog? Cached
# for preflight_ttl seconds. Warns only.
# INVARIANT: no fetch error text is kept, only the exception class and HTTP
# status; a redirect target or a malformed header value is response- or
# environment-controlled and could carry key material.
# INVARIANT: a cold fetch ends within preflight_deadline seconds; components
# still running are recorded as timed out and abandoned (daemon threads).

_VER_RE = re.compile(r"(\d+(?:\.\d+)*)")
_VER_TOKEN = re.compile(r"^([a-z]*)(\d+(?:\.\d+)*)$")
_DATE_TOKEN = re.compile(r"^\d{8}$")
_EFFORT_SUFFIX_RE = re.compile(r"-(?:low|medium|high|xhigh|max)$")
_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9.\-]*$")
CACHE_SCHEMA = 2   # 2: object-level redaction; caches from earlier code are discarded
MAX_BODY = 2_000_000


def _redact_obj(obj, redact):
    """Apply redact to every string inside a JSON-shaped object. Done on the
    object, not its serialisation: json.dumps escapes quotes, backslashes and
    newlines, so a literal-match redaction on the text can miss a value."""
    if isinstance(obj, str):
        return redact(obj)
    if isinstance(obj, list):
        return [_redact_obj(x, redact) for x in obj]
    if isinstance(obj, dict):
        return {redact(str(k)): _redact_obj(v, redact) for k, v in obj.items()}
    return obj


def parse_version(text):
    """First dotted (or bare) number in text as an int tuple, or None."""
    m = _VER_RE.search(text or "")
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


def compare_versions(a, b):
    """-1, 0, 1, or None when either side has no version. Missing components
    count as zero, so 1.0 equals 1.0.0."""
    va, vb = parse_version(a or ""), parse_version(b or "")
    if not va or not vb:
        return None
    n = max(len(va), len(vb))
    va, vb = va + (0,) * (n - len(va)), vb + (0,) * (n - len(vb))
    return (va > vb) - (va < vb)


def split_model(mid):
    """(family, version tuple, date). Version numbers, a date stamp (YYYYMMDD
    or Y-M-D tokens) and a trailing effort word leave the family:
    claude-opus-5-5 -> ('claude-opus', (5, 5), None);
    gemini-3.1-pro-high -> ('gemini-pro', (3, 1), None); kimi-k3 -> ('kimi-k', (3,), None).
    Family is None when the shape is ambiguous (two letter-prefixed numbers,
    as in foo-k2-r3): such ids are not ordered."""
    fam, ver, date, prefixed = [], [], None, 0
    toks = _EFFORT_SUFFIX_RE.sub("", (mid or "").lower()).split("-")
    i = 0
    while i < len(toks):
        tok = toks[i]
        if (i + 2 < len(toks) and re.match(r"^20\d\d$", tok)
                and re.match(r"^\d{1,2}$", toks[i + 1]) and re.match(r"^\d{1,2}$", toks[i + 2])):
            try:
                dt.date(int(tok), int(toks[i + 1]), int(toks[i + 2]))
            except ValueError:
                return None, (), None   # date-shaped but not a date: not assessed
            date = f"{tok}{int(toks[i + 1]):02d}{int(toks[i + 2]):02d}"
            i += 3
            continue
        i += 1
        if _DATE_TOKEN.match(tok):
            try:
                dt.date(int(tok[:4]), int(tok[4:6]), int(tok[6:]))
            except ValueError:
                return None, (), None
            date = tok
            continue
        m = _VER_TOKEN.match(tok)
        if m:
            if m.group(1):
                fam.append(m.group(1))
                prefixed += 1
            ver.extend(int(x) for x in m.group(2).split("."))
            continue
        fam.append(tok)
    if prefixed > 1:
        return None, (), None
    return "-".join(fam), tuple(ver), date


def newer_in_family(pinned, catalog):
    """(newer_id or None, pinned_present). newer_id is the catalog's newest
    entry in pinned's family when that beats pinned's own version. An
    unrecognised or unversioned pin is not ordered: (None, True)."""
    pf, pv, pd = split_model(pinned)
    if pf is None or not (pv or pd):   # nothing to order by; presence is still exact
        stem = _EFFORT_SUFFIX_RE.sub("", (pinned or "").lower())
        ids = {_EFFORT_SUFFIX_RE.sub("", (m["id"] if isinstance(m, dict) else m).lower())
               for m in catalog or []}
        return None, stem in ids
    best, present = None, False
    for m in catalog or []:
        mid = m["id"] if isinstance(m, dict) else m
        f, v, d = split_model(mid)
        if f != pf:
            continue
        if (v, d) == (pv, pd):
            present = True
        key = (v, d or "")
        if best is None or key > best[0]:
            # report the stem: an agy effort suffix is not part of the pin
            best = (key, _EFFORT_SUFFIX_RE.sub("", mid))
    if best and best[0] > (pv, pd or ""):
        return best[1], present
    return None, present


def _err_tag(exc):
    """Exception class plus HTTP status. Never the message."""
    code = getattr(exc, "code", None)
    return f"{exc.__class__.__name__} {code}" if isinstance(code, int) else exc.__class__.__name__


def installed_version(name):
    exe, on_path = find_binary(name)
    if not exe:
        return {"path": None, "on_path": False, "version": None}
    h = {"path": exe, "on_path": on_path, "version": None}
    try:
        out = subprocess.run([exe, "--version"], env=_cli_env(exe, on_path), capture_output=True,
                             text=True, errors="replace", timeout=15)
        if out.returncode != 0:
            raise RuntimeError(f"exit {out.returncode}")
        first = out.stdout.strip().splitlines()[0] if out.stdout.strip() else ""
        v = parse_version(first)
        if not v:
            raise ValueError("no version in output")
        h["version"] = ".".join(map(str, v))
    except Exception as exc:  # noqa: BLE001
        h["installed_error"] = _err_tag(exc)
    return h


def _get_json(url, headers=None, authenticated=False, timeout=10):
    """GET JSON, body capped at MAX_BODY bytes. An authenticated request
    refuses plain http and redirects."""
    if authenticated:
        _check_endpoint(url, True)
    req = urllib.request.Request(url, headers=dict(headers or {}, **{"User-Agent": "antagonist"}))
    opener = urllib.request.build_opener(_NoRedirect) if authenticated \
        else urllib.request.build_opener()
    with opener.open(req, timeout=timeout) as resp:
        return json.loads(resp.read(MAX_BODY).decode("utf-8", "replace"))


class BadResponse(RuntimeError):
    """A 200 whose body lacks the field the check depends on."""


def _require(d, key, kind):
    v = d.get(key) if isinstance(d, dict) else None
    if not isinstance(v, kind) or (kind is str and not v.strip()):
        raise BadResponse(key)
    return v


def npm_latest(pkg):
    return _require(_get_json(f"https://registry.npmjs.org/{pkg.replace('/', '%2F')}/latest"),
                    "version", str)


def github_latest(repo):
    tag = _require(_get_json(f"https://api.github.com/repos/{repo}/releases/latest"), "tag_name", str)
    return tag.lstrip("v")


def api_key_for(backend, cfg):
    env = {"anthropic": "ANTHROPIC_API_KEY", "moonshot": "MOONSHOT_API_KEY"}.get(backend)
    return read_key_file(cfg[backend].get("key_file")) or (os.environ.get(env) if env else None)


def catalog_anthropic(cfg):
    key = api_key_for("anthropic", cfg)
    if not key:
        raise RuntimeError("no key")
    base = cfg["anthropic"]["base_url"].rstrip("/")
    out, after, pages = [], None, 0
    while pages < 5:   # the list is paginated; five pages is far past today's size
        url = f"{base}/v1/models?limit=100" + (f"&after_id={urllib.parse.quote(str(after))}" if after else "")
        d = _get_json(url, headers={"x-api-key": key, "anthropic-version": "2023-06-01"},
                      authenticated=True)
        out += [{"id": m["id"], "created_at": m.get("created_at")} for m in _require(d, "data", list)]
        pages += 1
        after = d.get("last_id")
        if not (d.get("has_more") and after):
            return out
    raise BadResponse("has_more after 5 pages")


def catalog_openai_compat(backend, cfg):
    key = api_key_for(backend, cfg)
    d = _get_json(f"{cfg[backend]['base_url'].rstrip('/')}/models",
                  headers={"Authorization": f"Bearer {key}"} if key else {}, authenticated=bool(key))
    return [{"id": m["id"], "created_at": m.get("created")} for m in _require(d, "data", list)]


def catalog_agy():
    """`agy models` prints `slug<TAB>display name` lines after a status line;
    only tab-separated slug lines on a zero exit count."""
    exe, on_path = find_binary("agy")
    if not exe:
        raise RuntimeError("agy not found")
    out = subprocess.run([exe, "models"], env=_cli_env(exe, on_path), capture_output=True,
                         text=True, errors="replace", timeout=30)
    if out.returncode != 0:
        raise RuntimeError(f"exit {out.returncode}")
    ids = []
    for line in out.stdout.splitlines():
        parts = line.split("\t")
        slug = parts[0].strip()
        if len(parts) >= 2 and _SLUG_RE.match(slug) and slug not in ids:
            ids.append(slug)
    if not ids:
        raise RuntimeError("no model lines")
    return [{"id": s} for s in ids]


def codex_defaults():
    """codex publishes no catalog; its config default is the only model fact."""
    try:
        with open(os.path.join(HOME, ".codex", "config.toml"), "rb") as fh:
            d = tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return {"model": d.get("model"), "effort": d.get("model_reasoning_effort")}


def _harness_job(name, src):
    h = installed_version(name)
    h["latest_source"] = "npm" if "npm" in src else "github"
    try:
        h["latest"] = npm_latest(src["npm"]) if "npm" in src else github_latest(src["github"])
    except Exception as exc:  # noqa: BLE001
        h["latest"] = None
        h["latest_error"] = _err_tag(exc)
    return h


def fetch_preflight(cfg, deadline=None):
    """One fetch of everything the currency check needs. Components run in
    parallel daemon threads under one wall-clock deadline; each failure or
    timeout is recorded under `error`, never raised."""
    try:
        deadline = float(deadline if deadline is not None else cfg.get("preflight_deadline", 40))
    except (TypeError, ValueError):
        deadline = 40.0
    pre = {"v": CACHE_SCHEMA, "fetched_at": now_iso(), "fetched_epoch": time.time(),
           "harness": {}, "models": {}}
    jobs = {("harness", n): (lambda n=n, src=src: _harness_job(n, src)) for n, src in HARNESS.items()}
    jobs.update({("models", "anthropic"): lambda: {"ids": catalog_anthropic(cfg)},
                 ("models", "moonshot"): lambda: {"ids": catalog_openai_compat("moonshot", cfg)},
                 ("models", "local"): lambda: {"ids": catalog_openai_compat("local", cfg)},
                 ("models", "agy"): lambda: {"ids": catalog_agy()}})
    results = {}

    def run(key, fn):
        try:
            results[key] = fn()
        except Exception as exc:  # noqa: BLE001
            results[key] = {"error": _err_tag(exc)}

    threads = [threading.Thread(target=run, args=(k, fn), daemon=True) for k, fn in jobs.items()]
    t_end = time.monotonic() + deadline
    for t in threads:
        t.start()
    for t in threads:
        t.join(max(0.0, t_end - time.monotonic()))
    for (section, name) in jobs:
        r = results.get((section, name))
        if r is None:
            r = {"error": "Timeout (preflight deadline)"}
        if section == "models":
            r.setdefault("ids", None)
        pre[section][name] = r
    pre["models"]["codex"] = {"ids": None, "cli_default": codex_defaults()}
    errors = [r for sec in ("harness", "models") for r in pre[sec].values()
              if r.get("error") or r.get("latest_error") or r.get("installed_error")]
    # a fetch with failures is retried sooner than a clean one
    pre["ttl_s"] = 3600 if errors else None
    return pre


def _cache_fresh(pre, ttl):
    if not isinstance(pre, dict) or pre.get("v") != CACHE_SCHEMA:
        return False
    if not isinstance(pre.get("harness"), dict) or not isinstance(pre.get("models"), dict):
        return False
    try:
        age = time.time() - float(pre.get("fetched_epoch"))
        if pre.get("ttl_s") is not None:
            t = float(pre["ttl_s"])
            if not (0 < t < float("inf")):
                return False
            ttl = min(ttl, t)
        return 0 <= age < ttl
    except (TypeError, ValueError, OverflowError):
        return False   # a clock set backwards refetches rather than trusting forever


def load_preflight(cfg, secrets, refresh=False):
    """Cached fetch_preflight. The cache holds versions and model ids only,
    redacted before writing, mode 0600 from creation."""
    try:
        ttl = int(cfg.get("preflight_ttl", 86400))
    except (TypeError, ValueError):
        ttl = 86400
    if os.path.exists(CACHE_PATH):
        try:
            os.chmod(CACHE_PATH, 0o600)   # before reading: a cache from older code may be looser
        except OSError:
            pass
    pre = {} if refresh else read_json(CACHE_PATH, {})
    if _cache_fresh(pre, ttl):
        pre = _redact_obj(pre, secrets.redact)   # a cached object is data from disk: redact again
        pre.update(cache_age_s=int(time.time() - float(pre["fetched_epoch"])), from_cache=True)
        return pre
    # Redact once, on the object: the returned dict feeds notes that reach
    # stderr and meta.json, not only the cache file.
    pre = _redact_obj(fetch_preflight(cfg), secrets.redact)
    os.makedirs(os.path.dirname(CACHE_PATH), mode=0o700, exist_ok=True)
    write_text_atomic(CACHE_PATH, json.dumps(pre, indent=2, sort_keys=True), mode=0o600)
    pre.update(cache_age_s=0, from_cache=False)
    return pre


def preflight_notes(backend, model, pre):
    """Currency warnings for one backend. `model` is the effective model for
    the run; None means the CLI's own default (nothing to compare)."""
    notes = []
    h = (pre.get("harness") or {}).get(backend)
    if h:
        if h.get("path") and not h.get("on_path"):
            notes.append(f"{backend} is not on PATH; using {h['path']}")
        if compare_versions(h.get("version"), h.get("latest")) == -1:
            notes.append(f"{backend} {h['version']} installed, {h['latest']} is "
                         f"{h.get('latest_source')} latest (a pinned release channel may lag by design)")
        if h.get("installed_error"):
            notes.append(f"{backend}: installed version unknown ({h['installed_error']})")
        if h.get("latest_error") or (h.get("error") and not h.get("installed_error")):
            notes.append(f"{backend}: latest release unknown ({h.get('latest_error') or h.get('error')})")
    m = (pre.get("models") or {}).get(backend) or {}
    if model and backend in ("codex", "claude"):
        notes.append(f"{backend} model {model} cannot be assessed: the CLI publishes no catalog")
    elif model and m.get("ids") is not None:
        newer, present = newer_in_family(model, m["ids"])
        if newer:
            notes.append(f"{backend} model {model} is pinned; newer in its family: {newer}")
        elif not present:
            notes.append(f"{backend} model {model} is not in the backend's catalog")
    elif model and m.get("error"):
        notes.append(f"{backend}: model catalog unavailable ({m['error']})")
    return notes


def preflight_enabled(args):
    env_off = os.environ.get("ANTAGONIST_NO_PREFLIGHT", "").strip().lower() not in ("", "0", "false", "no")
    return not (getattr(args, "no_preflight", False) or env_off)


def cmd_preflight(args, cfg):
    secrets = Secrets(cfg)
    pre = load_preflight(cfg, secrets, refresh=args.refresh)

    def out(*a):   # every line of this command is redacted
        sys.stdout.write(" ".join(secrets.redact(str(x)) for x in a) + "\n")
    src = f"cache, {pre['cache_age_s']}s old" if pre.get("from_cache") else "fetched now"
    out(f"preflight: {pre.get('fetched_at')} ({src})   cache: {CACHE_PATH}")
    out("\nharness:")
    for name, h in pre.get("harness", {}).items():
        where = ("not found" if not h.get("path")
                 else h["path"] + ("" if h.get("on_path") else " (not on PATH)"))
        c = compare_versions(h.get("version"), h.get("latest"))
        state = {-1: "behind", 0: "latest", 1: "ahead"}.get(c, "unknown")
        errs = [h[k] for k in ("error", "installed_error", "latest_error") if h.get(k)]
        out(f"  {name:<9} installed {h.get('version') or '?':<9} "
              f"{h.get('latest_source') or ''} latest {h.get('latest') or '?':<9} "
              f"{state:<8} {where}" + (f"  [{'; '.join(errs)}]" if errs else ""))
    out("\nmodels:")
    for name in BACKENDS:
        m = pre.get("models", {}).get(name) or {}
        pinned = cfg.get(name, {}).get("model")
        if name == "codex":
            cd = m.get("cli_default") or {}
            out(f"  {name:<9} pinned {pinned or '(default)':<18} no catalog; CLI config default "
                  f"{cd.get('model') or '?'} / {cd.get('effort') or '?'}")
            continue
        if name == "claude":
            out(f"  {name:<9} pinned {pinned or '(default)':<18} "
                  + ("follows the CLI default" if not pinned else "no catalog; not assessed"))
            continue
        ids = m.get("ids")
        if ids is None:
            out(f"  {name:<9} pinned {pinned or '(default)':<18} catalog unavailable: {m.get('error')}")
            continue
        newest = sorted(ids, key=lambda x: str(x.get("created_at") or ""), reverse=True)[:4]
        if not pinned:
            mark = "not assessed (CLI default)"
        else:
            fam, ver, _ = split_model(pinned)
            newer, present = newer_in_family(pinned, ids)
            mark = ("not assessed (unrecognised id shape)" if fam is None or not ver
                    else f"NEWER IN FAMILY: {newer}" if newer
                    else "not in catalog" if not present else "current")
        out(f"  {name:<9} pinned {pinned or '(default)':<18} {mark}; newest listed: "
              + ", ".join(x["id"] + (f" ({x['created_at']})" if x.get("created_at") else "")
                          for x in newest))
    notes = [n for name in BACKENDS for n in preflight_notes(name, cfg.get(name, {}).get("model"), pre)]
    out("\nnotes:" + ("" if notes else " none"))
    for n in notes:
        out(f"  - {secrets.redact(n)}")


