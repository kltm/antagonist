def new_run_dir(backend, label):
    os.makedirs(RUNS_ROOT, mode=0o700, exist_ok=True)
    os.chmod(RUNS_ROOT, 0o700)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    name = f"{stamp}-{backend}" + (f"-{re.sub(r'[^A-Za-z0-9_.-]+', '-', label)}" if label else "")
    path = os.path.join(RUNS_ROOT, name)
    n = 1
    while os.path.exists(path):
        n += 1
        path = os.path.join(RUNS_ROOT, f"{name}-{n}")
    os.makedirs(path, mode=0o700)
    fsync_path(RUNS_ROOT)   # the directory entry itself must survive a crash
    return path


def cmd_run(args, cfg):
    backend = args.backend or cfg["default_backend"]
    if backend not in BACKENDS:
        die(f"unknown backend {backend!r}; one of {', '.join(BACKENDS)}")
    if bool(args.prompt_file) == bool(args.prompt):
        die("give exactly one of --prompt-file or --prompt")
    if args.timeout is not None and args.timeout <= 0:
        die("--timeout must be a positive number of seconds")
    if args.idle_timeout is not None and args.idle_timeout <= 0:
        die("--idle-timeout must be a positive number of seconds")
    cwd = os.path.abspath(args.cwd or os.getcwd())
    if not os.path.isdir(cwd):
        die(f"--cwd {cwd} is not a directory")
    if args.prompt_file:
        try:
            with open(args.prompt_file, encoding="utf-8", newline="") as fh:
                task = fh.read()
        except (OSError, UnicodeDecodeError) as exc:
            die(f"cannot read --prompt-file: {exc}")
    else:
        task = args.prompt
    if args.max_words is not None:
        if args.max_words <= 0:
            die("--max-words must be a positive integer")
        task = task.rstrip() + (f"\n\nAnswer in at most {args.max_words} words. Prefer fewer, "
                                "better-evidenced findings over completeness; stop when the budget "
                                "is spent rather than truncating a finding.\n")
    evidence = resolve_evidence(cwd, args.evidence)
    b = cfg[backend]
    model = (args.model or b.get("model") or "").strip() or None
    effort = norm_effort(backend, args.effort or b.get("effort"), model)
    opts = {
        "cwd": cwd, "model": model, "effort": effort,
        "timeout": int(args.timeout if args.timeout is not None else cfg.get("timeout", 3600)),
        "idle_timeout": int(args.idle_timeout if args.idle_timeout is not None
                            else cfg.get("idle_timeout", 300)),
        "key_file": b.get("key_file"), "base_url": b.get("base_url"),
        "max_tokens": b.get("max_tokens"),
        "fallbacks": (b.get("fallbacks", True) and not args.no_fallbacks),
    }
    ok, note = probe(backend, cfg, model=model)
    if not ok:
        die(f"backend {backend} unavailable: {note}")
    try:
        prompt = assemble_prompt(task, evidence, backend, cwd, preamble=not args.no_preamble)
    except ValueError as exc:
        die(str(exc))
    secrets = Secrets(cfg)
    hits = scan_for_secrets(prompt, secrets)
    for what, val in (("label", args.label), ("model", model), ("cwd", cwd),
                      ("base_url", opts["base_url"])):
        if val and scan_for_secrets(str(val), secrets):
            die(f"--{what} looks like it contains a credential")
    known = [h for h in hits if h[1] == "known credential value"]
    if known or (hits and not args.allow_secrets):
        lines = "\n".join(f"  prompt line {n}: {label}" for n, label in hits[:20])
        die("refusing to run: the assembled prompt contains credential-shaped text "
            f"(nothing was written):\n{lines}\n  Remove it from the prompt or evidence"
            + ("" if known else ", or pass --allow-secrets if these are known false positives")
            + ".")
    if backend == "codex" and FRAMING_WORDS.search(prompt):
        print("antagonist: note: prompt contains attack/bypass wording; codex's classifier "
              "has refused that framing before. Consider hardening-review phrasing.",
              file=sys.stderr)
    if backend == "agy" and SEARCH_WORDS.search(task):
        print("antagonist: note: the prompt asks the reviewer to search or explore; agy headless "
              "cannot run commands or search tools and a denial ends the run. Run the search "
              "yourself and attach the output with -e, or use codex.", file=sys.stderr)
    pre_notes, pre_at = [], None
    if preflight_enabled(args):
        try:
            pre = load_preflight(cfg, secrets, refresh=args.refresh)
            pre_at = pre.get("fetched_at")
            pre_notes = [secrets.redact(n) for n in preflight_notes(backend, model, pre)]
        except Exception as exc:  # noqa: BLE001
            pre_notes = [f"preflight unavailable ({exc.__class__.__name__}); run continues"]
        for n in pre_notes:
            print(f"antagonist: preflight: {n}", file=sys.stderr)
        if args.strict and pre_notes:
            die("refusing to run under --strict: see the preflight notes above")
    run_dir = new_run_dir(backend, args.label)
    write_text_atomic(os.path.join(run_dir, "prompt.md"), prompt)
    meta = {
        "backend": backend, "model": model, "effort": effort, "cwd": cwd,
        "evidence": evidence, "prompt_bytes": len(prompt.encode()), "label": args.label,
        "status": "queued", "worker_pid": None, "created_ns": time.time_ns(),
        "started": None, "finished": None, "duration_s": None,
        "timeout_s": opts["timeout"], "idle_timeout_s": opts["idle_timeout"],
        "error": None,
        "preflight": {"fetched_at": pre_at, "notes": pre_notes},
        "max_words": args.max_words,
    }
    write_json(os.path.join(run_dir, "meta.json"), meta)
    # opts.json carries the key file *path* (not a secret) so the worker does
    # not depend on the config file staying unchanged between spawn and start.
    write_json(os.path.join(run_dir, "opts.json"), opts)
    if args.detach:
        # The launcher never touches meta.json after the worker exists: the
        # worker owns it from here. The worker's identity goes to launcher.json.
        log = open(os.path.join(run_dir, "worker.log"), "ab")
        try:
            proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_worker", run_dir],
                                    stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                    start_new_session=True, close_fds=True)
        except OSError as exc:
            meta.update(status="failed", error=f"could not spawn worker: {exc}",
                        finished=now_iso())
            write_json(os.path.join(run_dir, "meta.json"), meta)
            die(f"could not spawn worker: {exc}", 1)
        write_json(os.path.join(run_dir, "launcher.json"),
                   {"worker_pid": proc.pid, "worker_start": proc_start(proc.pid)})
        print(run_dir, flush=True)
        return
    rc = worker(run_dir)
    if not args.quiet:
        res = os.path.join(run_dir, "result.md")
        if os.path.exists(res):
            sys.stdout.write(open(res).read())
    print(f"\n[antagonist] run dir: {run_dir}", file=sys.stderr)
    sys.exit(rc)


def worker(run_dir):
    """Execute one run. Everything is inside the try so any failure lands in
    meta.json rather than leaving the run `queued`/`running` forever."""
    meta_p = os.path.join(run_dir, "meta.json")
    meta = read_json(meta_p) or {"status": "queued"}
    t0 = time.monotonic()
    secrets = None
    rc = 1
    try:
        cfg = load_config()
        secrets = Secrets(cfg)
        opts = read_json(os.path.join(run_dir, "opts.json"))
        if not opts:
            raise RuntimeError("opts.json missing or unreadable")
        prompt = open(os.path.join(run_dir, "prompt.md")).read()
        meta.update(status="running", started=now_iso(), worker_pid=os.getpid(),
                    worker_start=proc_start(os.getpid()))
        write_json(meta_p, meta)
        opts["_redact"] = secrets.redact
        backend = meta["backend"]
        # API backends: urllib's timeout is per socket operation; the alarm
        # makes --timeout a wall-clock bound. CLI backends bound and kill their
        # child in _run_cli instead.
        if backend in API_BACKENDS:
            signal.signal(signal.SIGALRM, _on_alarm)
            signal.alarm(int(opts["timeout"]) + 5)
        try:
            out = BACKENDS[backend](run_dir, prompt, opts)
        finally:
            signal.alarm(0)
            for name in ("stdout.log", "stderr.log", "worker.log", "result.raw.md",
                         "reasoning.md", "cmd.txt", "opts.json"):
                secrets.redact_file(os.path.join(run_dir, name))
        write_text_atomic(os.path.join(run_dir, "result.md"),
                          secrets.redact(out["result_text"]).rstrip() + "\n")
        meta.update(status="done", model_served=out.get("model"), usage=out.get("usage"),
                    raw_status=out.get("raw_status"), extra=out.get("extra"))
        rc = 0
    except Exception as exc:  # noqa: BLE001
        msg = str(exc)[:2000]
        if secrets:
            msg = secrets.redact(msg)
        meta.update(status="failed", error=msg)
    finally:
        meta.update(finished=now_iso(), duration_s=round(time.monotonic() - t0, 1))
        text = json.dumps(meta, indent=2, sort_keys=True)
        write_text_atomic(meta_p, secrets.redact(text) if secrets else text)
    return rc


def is_run_dir(path):
    return os.path.isdir(path) and os.path.exists(os.path.join(path, "meta.json"))


def list_runs():
    """Run dirs oldest first, ordered by creation time, not by name (two runs
    started in the same second sort by backend name otherwise)."""
    if not os.path.isdir(RUNS_ROOT):
        return []
    entries = []
    for n in os.listdir(RUNS_ROOT):
        rd = os.path.join(RUNS_ROOT, n)
        if is_run_dir(rd):
            meta = read_json(os.path.join(rd, "meta.json"), {})
            entries.append((meta.get("created_ns") or int(os.stat(rd).st_mtime_ns), n, rd))
    return [rd for _, _, rd in sorted(entries)]


def resolve_run(arg):
    if arg in (None, "--last", "last"):
        runs = list_runs()
        if not runs:
            die("no runs yet")
        return runs[-1]
    for cand in (arg, os.path.join(RUNS_ROOT, arg)):
        if is_run_dir(cand):
            return os.path.abspath(cand)
    die(f"no such run: {arg}")


def worker_identity(run_dir, meta):
    """(pid, start) of the worker: from meta once it is running, else from the
    launcher's record."""
    if meta.get("worker_pid"):
        return meta["worker_pid"], meta.get("worker_start")
    launcher = read_json(os.path.join(run_dir, "launcher.json"), {})
    return launcher.get("worker_pid"), launcher.get("worker_start")


def describe(run_dir, meta):
    """Status with liveness: a queued or running run whose worker is gone is `died`."""
    st = meta.get("status")
    if st in ("queued", "running"):
        pid, start = worker_identity(run_dir, meta)
        if pid is not None and not pid_alive(pid, start):
            st = "died"
    return st


def orphaned_child(run_dir):
    """pgid of a CLI child group still alive after its worker died, or None."""
    try:
        pgid = int(open(os.path.join(run_dir, "child.pid")).read())
    except (OSError, ValueError):
        return None
    return pgid if _group_alive(pgid) else None


# Known failure strings and the fix. Matched against the error and the tail
# of stderr.log; printed by `status` as `hint:`.
HINTS = [
    (re.compile(r"tool was denied", re.I),
     "agy headless cannot run commands or search tools. Attach search output as evidence (-e) "
     "and check read grants with `antagonist backends`; or use codex."),
    (re.compile(r"exceeded the output token limit", re.I),
     "the answer outgrew agy's output cap. Rerun with --max-words (about 1500) and fewer, "
     "narrower questions; the partial draft in stdout.log is not a result."),
    (re.compile(r"cybersecurity risk|flagged for possible", re.I),
     "codex's classifier refused the framing. Rephrase as a hardening review from the "
     "owner's side (no attack/bypass wording) and rerun."),
    (re.compile(r"binary not found", re.I),
     "the backend CLI is not on PATH or in the fallback directories; `antagonist backends`."),
    (re.compile(r"went silent|incomplete", re.I),
     "the stream stalled or ended early. Rerun; at `high` rather than `max` for a "
     "long-reasoning API model."),
]


def hint_for(run_dir, error):
    tail = ""
    try:
        with open(os.path.join(run_dir, "stderr.log"), errors="replace") as fh:
            tail = fh.read()[-4000:]
    except OSError:
        pass
    for rx, text in HINTS:
        if rx.search(error or "") or rx.search(tail):
            return text
    return None


def cmd_status(args, cfg):
    run_dir = resolve_run(args.run)
    secrets = Secrets(cfg)
    meta = read_json(os.path.join(run_dir, "meta.json"), {})
    st = describe(run_dir, meta)
    print(f"run:      {run_dir}")
    print(f"status:   {st}")
    for k in ("backend", "model", "effort", "cwd", "started", "finished", "duration_s",
              "timeout_s", "idle_timeout_s"):
        print(f"{k + ':':<16}{secrets.redact(str(meta.get(k)))}")
    if meta.get("model_served"):
        print(f"served:         {secrets.redact(str(meta['model_served']))}")
    if meta.get("usage"):
        print(f"usage:          {json.dumps(meta['usage'])}")
    if meta.get("error"):
        print(f"error:          {secrets.redact(meta['error'])}")
        h = hint_for(run_dir, meta["error"])
        if h:
            print(f"hint:           {h}")
    if st == "died":
        pgid = orphaned_child(run_dir)
        if pgid:
            print(f"orphan:         the CLI child group {pgid} is still running; stop it "
                  f"before rerunning:  kill -TERM -- -{pgid}")
    if st == "running" and meta.get("started"):
        started = dt.datetime.fromisoformat(meta["started"])
        print(f"elapsed:        {int((dt.datetime.now().astimezone() - started).total_seconds())}s")
        for name in ("stderr.log", "stdout.log"):
            p = os.path.join(run_dir, name)
            if os.path.exists(p) and os.path.getsize(p):
                tail = open(p, errors="replace").read()[-600:]
                print(f"--- tail {name}\n{secrets.redact(tail)}")
    if args.wait and st in ("queued", "running"):
        # Bounded: poll every 10 s for at most --wait seconds, then return
        # with exit 3 so the caller can decide to call again.
        deadline = time.monotonic() + args.wait
        while time.monotonic() < deadline:
            time.sleep(min(10, max(0.05, deadline - time.monotonic())))
            meta = read_json(os.path.join(run_dir, "meta.json"), {})
            st = describe(run_dir, meta)
            if st not in ("queued", "running"):
                print(f"status:   {st}  ({meta.get('duration_s')}s)")
                if meta.get("error"):
                    print(f"error:    {secrets.redact(meta['error'])}")
                    h = hint_for(run_dir, meta["error"])
                    if h:
                        print(f"hint:     {h}")
                break
        else:
            print(f"status:   still {st} after {args.wait}s")
    if st in ("queued", "running"):
        sys.exit(3)
    sys.exit(0 if st == "done" else 1)


def cmd_result(args, cfg):
    run_dir = resolve_run(args.run)
    meta = read_json(os.path.join(run_dir, "meta.json"), {})
    st = describe(run_dir, meta)
    if st != "done":
        die(f"run is {st}" + (f": {Secrets(cfg).redact(meta.get('error'))}"
                             if meta.get("error") else ""), 1)
    sys.stdout.write(open(os.path.join(run_dir, "result.md")).read())


def cmd_list(args, cfg):
    secrets = Secrets(cfg)
    for rd in list_runs()[-args.n:]:
        meta = read_json(os.path.join(rd, "meta.json"), {})
        print(f"{os.path.basename(rd):<48} {describe(rd, meta):<8} "
              f"{str(meta.get('duration_s') or ''):>7}s  "
              f"{secrets.redact(str(meta.get('model_served') or meta.get('model') or ''))}")


def cmd_agy_allow(args, cfg):
    """Add a read_file grant for DIR to agy's settings.json (backup first).
    PRE: agy has no `config set`; the file is the only write path.
    POST: `agy -p /permissions` lists the grant."""
    path = os.path.join(HOME, ".gemini/antigravity-cli/settings.json")
    if not os.path.exists(path):
        die(f"{path} missing; run agy once interactively first")
    d = read_json(path)
    if d is None:
        die(f"{path} is not valid JSON")
    target = os.path.abspath(args.dir).rstrip("/") + "/"
    grant = f"read_file({target})"
    allow = d.setdefault("permissions", {}).setdefault("allow", [])
    if grant in allow:
        print(f"already present: {grant}")
        return
    bak = path + ".bak-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.copy2(path, bak)
    allow.append(grant)
    write_json(path, d)
    print(f"added {grant}\nbackup: {bak}\nverify: agy -p /permissions")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="antagonist", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="run a review")
    r.add_argument("--backend", "-b", choices=list(BACKENDS))
    r.add_argument("--prompt-file", "-f")
    r.add_argument("--prompt", "-p")
    r.add_argument("--evidence", "-e", action="append", default=[],
                   help="file to paste verbatim (repeatable; relative paths resolve against --cwd)")
    r.add_argument("--cwd", help="review workspace for CLI backends (default: current dir)")
    r.add_argument("--effort", choices=EFFORTS)
    r.add_argument("--model")
    r.add_argument("--timeout", type=int, help="wall-clock seconds (default from config, 3600)")
    r.add_argument("--idle-timeout", type=int,
                   help="API backends: max seconds of stream silence (default 300)")
    r.add_argument("--label", help="suffix for the run directory name")
    r.add_argument("--detach", "-d", action="store_true",
                   help="start in the background and print the run dir")
    r.add_argument("--no-preamble", action="store_true",
                   help="send the prompt file as-is, without the reviewer preamble")
    r.add_argument("--no-fallbacks", action="store_true",
                   help="anthropic: do not request server-side refusal fallbacks")
    r.add_argument("--allow-secrets", action="store_true",
                   help="run even if the prompt matches a credential pattern (known values still refuse)")
    r.add_argument("--quiet", "-q", action="store_true", help="do not print the result")
    r.add_argument("--max-words", type=int, metavar="N",
                   help="append a word budget to the task (agy has an output cap; ~1500 is safe)")
    r.add_argument("--no-preflight", action="store_true",
                   help="skip the harness/model currency check (also: ANTAGONIST_NO_PREFLIGHT=1)")
    r.add_argument("--refresh", action="store_true", help="refetch the currency check, ignoring the cache")
    r.add_argument("--strict", action="store_true",
                   help="refuse to run when the currency check has any note")
    r.set_defaults(fn=cmd_run)

    b = sub.add_parser("backends", help="show backend availability, defaults, and currency notes")
    b.add_argument("--refresh", action="store_true", help="refetch the currency check")
    b.add_argument("--no-preflight", action="store_true", help="skip the currency check")
    b.set_defaults(fn=cmd_backends)

    pf = sub.add_parser("preflight", help="harness versions and model catalogs vs the pinned defaults")
    pf.add_argument("--refresh", action="store_true", help="refetch, ignoring the cache")
    pf.set_defaults(fn=cmd_preflight)

    s = sub.add_parser("status", help="status of a run (default: last)")
    s.add_argument("run", nargs="?")
    s.add_argument("--wait", type=int, metavar="SECS",
                   help="poll for up to SECS seconds; exit 3 if still running")
    s.set_defaults(fn=cmd_status)

    g = sub.add_parser("result", help="print a finished run's result (default: last)")
    g.add_argument("run", nargs="?")
    g.set_defaults(fn=cmd_result)

    l = sub.add_parser("list", help="recent runs")
    l.add_argument("-n", type=int, default=20)
    l.set_defaults(fn=cmd_list)

    a = sub.add_parser("agy-allow", help="grant agy headless read access to a directory")
    a.add_argument("dir")
    a.set_defaults(fn=cmd_agy_allow)

    w = sub.add_parser("_worker")
    w.add_argument("run_dir")
    w.set_defaults(fn=lambda args, cfg: sys.exit(worker(args.run_dir)))

    args = ap.parse_args(argv)
    cfg = load_config()
    args.fn(args, cfg)


if __name__ == "__main__":
    main()
