# --------------------------------------------------------------------- utils

def die(msg, code=2):
    print(f"antagonist: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))  # deep copy
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, "rb") as fh:
            user = tomllib.load(fh)
        for k, v in user.items():
            if isinstance(v, dict) and isinstance(cfg.get(k), dict):
                cfg[k].update(v)
            else:
                cfg[k] = v
    for name in API_BACKENDS:
        if cfg[name].get("key_file"):
            cfg[name]["key_file"] = os.path.expanduser(cfg[name]["key_file"])
        cfg[name]["base_url"] = (cfg[name].get("base_url") or "").rstrip("/")
    # The Anthropic path is appended as /v1/messages; a base_url that already
    # ends in /v1 would double it.
    if cfg["anthropic"]["base_url"].endswith("/v1"):
        cfg["anthropic"]["base_url"] = cfg["anthropic"]["base_url"][:-3]
    return cfg


# Only an UPPER_CASE shell identifier counts as an assignment; a bare token
# such as `abc=def==` is kept whole.
_ASSIGN_RE = re.compile(r"^(?:export\s+)?[A-Z][A-Z0-9_]*=(.*)$")


def read_key_file(path):
    """Accept a raw token, `KEY=value`, or `export KEY=value`. Never echo it."""
    if not path or not os.path.exists(path):
        return None
    with open(path) as fh:
        raw = fh.read().strip()
    line = raw.splitlines()[0].strip() if raw else ""
    m = _ASSIGN_RE.match(line)
    if m:
        line = m.group(1).strip()
    return line.strip("'\"") or None


class Secrets:
    """Known credential values, for redaction and prompt refusal. In memory only."""

    def __init__(self, cfg):
        vals = set()
        for name in API_BACKENDS:
            v = read_key_file(cfg[name].get("key_file"))
            if v:
                vals.add(v)
        for k, v in os.environ.items():
            if ENV_SECRET_RE.search(k) and len(v) >= 8:
                vals.add(v)
        self.values = sorted(vals, key=len, reverse=True)

    def redact(self, text):
        if not text:
            return text
        for v in self.values:
            text = text.replace(v, "<redacted>")
        return text

    def redact_file(self, path):
        if not os.path.exists(path) or not self.values:
            return
        with open(path, "rb") as fh:
            data = fh.read()
        new = data
        for v in self.values:
            new = new.replace(v.encode(), b"<redacted>")
        if new != data:
            with open(path, "wb") as fh:
                fh.write(new)


def child_env():
    """Environment for CLI children: secret-looking variables removed."""
    env = {}
    for k, v in os.environ.items():
        if k in ENV_KEEP or not ENV_SECRET_RE.search(k):
            env[k] = v
    return env


def scan_for_secrets(text, secrets):
    """Return [(line_no, label)] for credential shapes or known values. No text."""
    hits = []
    for i, line in enumerate(text.splitlines(), 1):
        for v in secrets.values:
            if v in line:
                hits.append((i, "known credential value"))
                break
        else:
            for label, rx in SECRET_PATTERNS:
                if rx.search(line):
                    hits.append((i, label))
                    break
    return hits


def guess_lang(path):
    ext = os.path.splitext(path)[1].lower()
    return {
        ".py": "python", ".sh": "bash", ".bash": "bash", ".js": "javascript",
        ".ts": "typescript", ".json": "json", ".yaml": "yaml", ".yml": "yaml",
        ".toml": "toml", ".tf": "hcl", ".md": "markdown", ".conf": "apache",
        ".cfg": "ini", ".ini": "ini", ".sql": "sql", ".rb": "ruby", ".go": "go",
        ".rs": "rust", ".txt": "", ".diff": "diff", ".patch": "diff",
    }.get(ext, "")


def fence_for(text):
    longest = max((len(m) for m in re.findall(r"`{3,}", text)), default=0)
    return "`" * max(3, longest + 1)


_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def has_visible_text(s):
    """True if s contains a character that would render: not whitespace, not a
    control/format/zero-width character, not an ANSI escape."""
    s = _ANSI_RE.sub("", s or "")
    return any(not ch.isspace() and unicodedata.category(ch) not in ("Cc", "Cf", "Zs", "Zl", "Zp")
               for ch in s)


def resolve_evidence(cwd, paths):
    """Relative evidence paths resolve against the review workspace, not the
    directory the command happens to run from."""
    out = []
    for p in paths:
        ap = os.path.abspath(p if os.path.isabs(p) else os.path.join(cwd, p))
        if not os.path.isfile(ap):
            die(f"evidence not found: {ap}")
        out.append(ap)
    return out


def read_evidence(path):
    """Bytes in, exact text out: strict UTF-8, newlines untouched."""
    with open(path, "rb") as fh:
        data = fh.read()
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ValueError(f"{path} is not valid UTF-8 at byte {exc.start}; "
                         "evidence must be text") from None
    return text, len(data)


def assemble_prompt(task_text, evidence, backend, cwd, preamble=True, note_key=None,
                    read_dirs=()):
    """`evidence` is a list of absolute paths. With preamble=False the task
    text goes through unchanged (no heading, no trimming); evidence, if any,
    is still appended. `note_key` selects the CLI note (default: the backend);
    `read_dirs` are the other directories attached for reading."""
    parts = []
    if preamble:
        parts.append(PREAMBLE)
        if (note_key or backend) in CLI_NOTE:
            dirs = " and ".join(f"`{d}`" for d in [cwd] + list(read_dirs))
            parts.append(CLI_NOTE[note_key or backend].format(cwd=cwd, dirs=dirs) + "\n")
        parts.append("# Task\n\n" + task_text.rstrip() + "\n")
    else:
        parts.append(task_text)
    if evidence:
        parts.append("# Evidence\n")
        for ap in evidence:
            body, nbytes = read_evidence(ap)
            fence = fence_for(body)
            if not body.endswith("\n"):
                body += "\n"
            parts.append(f"## `{ap}` ({nbytes} bytes)\n\n"
                         f"{fence}{guess_lang(ap)}\n{body}{fence}\n")
    return "\n".join(parts)


def norm_effort(backend, effort, model):
    """Map the shared low..max scale onto what each backend accepts."""
    if effort is None:
        return None
    if effort not in EFFORTS:
        die(f"--effort must be one of {', '.join(EFFORTS)}")
    if backend in ("codex", "claude", "anthropic"):
        return effort
    if backend == "agy":
        return {"low": "low", "medium": "medium", "high": "high",
                "xhigh": "high", "max": "high"}[effort]
    if backend == "moonshot":
        if model and re.match(r"^kimi-k3(?:$|-)", model):
            # kimi-k3 has low|high|max; medium rounds up, not down.
            return {"low": "low", "medium": "high", "high": "high",
                    "xhigh": "max", "max": "max"}[effort]
        return None
    return None


def fsync_path(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


_UMASK = os.umask(0)
os.umask(_UMASK)


def write_text_atomic(path, text, mode=None):
    """Unique temp file in the same directory (concurrent writers cannot share
    one), created at its final mode (umask-applied 0666 unless given), fsynced,
    renamed over path. A failure removes the temp file."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as fh:   # owns fd from here, so a chmod failure cannot leak it
            os.fchmod(fh.fileno(), mode if mode is not None else (0o666 & ~_UMASK))
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    fsync_path(d)


def write_json(path, obj):
    write_text_atomic(path, json.dumps(obj, indent=2, sort_keys=True))


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):   # ValueError covers JSONDecodeError and bad UTF-8
        return default


def proc_start(pid):
    """Linux process start time (clock ticks since boot) from /proc, or None."""
    try:
        with open(f"/proc/{pid}/stat") as fh:
            return int(fh.read().rsplit(")", 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def pid_alive(pid, start=None):
    """Liveness with same-boot pid-reuse protection when a start time is known."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    if start is not None:
        return proc_start(pid) == start
    return True


class WallClockTimeout(RuntimeError):
    pass


def _on_alarm(signum, frame):
    raise WallClockTimeout("wall-clock timeout")


# ------------------------------------------------------------------ backends
# Each backend: run_<name>(run_dir, prompt, opts) -> dict(result_text, usage,
# model, raw_status, extra). Raises RuntimeError on failure with a message.

def find_binary(name):
    """(path, on_path). Off-PATH hits come from FALLBACK_BIN_DIRS, newest nvm
    version first."""
    exe = shutil.which(name)
    if exe:
        return os.path.abspath(exe), True   # PATH may hold "." : pin the file we checked
    for pat in FALLBACK_BIN_DIRS:
        # newest version first: v20.20.0 before v9.0.0, which a plain sort inverts
        dirs = sorted(glob.glob(pat), reverse=True,
                      key=lambda p: parse_version(os.path.basename(os.path.dirname(p))) or (0,))
        for d in dirs:
            cand = os.path.join(d, name)
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                return cand, False
    return None, False


def _cli_env(exe, on_path):
    """child_env, with the binary's own directory first on PATH when it was
    found off PATH (an npm shim needs the node next to it)."""
    env = child_env()
    if not on_path:
        env["PATH"] = os.path.dirname(exe) + os.pathsep + (env.get("PATH") or os.defpath)
    return env


WATCH_POLL = 2.0   # seconds between calls to a _run_cli watch function


def _run_cli(run_dir, argv, stdin_text, cwd, timeout, stdin_name="prompt.md", env_drop=(),
             watch=None, info=None):
    """Run a CLI backend in its own process group with a wall-clock bound.
    PRE: stdin_text is what goes to the child's stdin; when it is not the
    assembled prompt it is saved under stdin_name so cmd.txt reproduces it.
    watch, if given, is called every WATCH_POLL seconds while the child runs;
    a truthy return ends the run early and is stored in info["stopped"].
    POST: on timeout the whole process group gets SIGTERM, then SIGKILL after
    10 s regardless of whether the direct child already exited. Processes that
    left the group (their own setsid) are out of reach; that is the scope."""
    if os.path.isabs(argv[0]):
        exe, on_path = argv[0], True
    else:
        exe, on_path = find_binary(argv[0])
        if not exe:
            raise RuntimeError(f"{argv[0]}: binary not found on PATH or in fallback dirs")
        argv = [exe] + list(argv[1:])   # the file that was checked is the file that runs
    env = _cli_env(exe, on_path)
    for name in env_drop:
        env.pop(name, None)
    if stdin_name != "prompt.md":
        with open(os.path.join(run_dir, stdin_name), "w") as fh:
            fh.write(stdin_text)
    with open(os.path.join(run_dir, "cmd.txt"), "w") as fh:
        unset = "".join(f"-u {shlex.quote(n)} " for n in env_drop)
        fh.write(f"cd {shlex.quote(cwd)} && " + (f"env {unset}" if unset else "")
                 + " ".join(shlex.quote(a) for a in argv)
                 + f" < {shlex.quote(os.path.join(run_dir, stdin_name))}\n")
    out_p = os.path.join(run_dir, "stdout.log")
    err_p = os.path.join(run_dir, "stderr.log")
    stopped = False   # ended by the watch function; the group is already killed
    with open(out_p, "wb") as out, open(err_p, "wb") as err:
        proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE, stdout=out,
                                stderr=err, start_new_session=True, env=env)
        with open(os.path.join(run_dir, "child.pid"), "w") as fh:
            fh.write(str(proc.pid))
        try:
            if watch is None:
                proc.communicate(stdin_text.encode(), timeout=timeout)
            else:
                # CAVEAT: communicate() cannot be polled here. After its first
                # TimeoutExpired it stops writing stdin, so a child that had not
                # yet drained a prompt larger than the pipe buffer never sees
                # the rest or end-of-input. A thread owns the write instead.
                def feed():
                    try:
                        proc.stdin.write(stdin_text.encode())
                    except (OSError, ValueError):
                        pass   # the child exited or was killed first
                    finally:
                        try:
                            proc.stdin.close()
                        except (OSError, ValueError):
                            pass
                threading.Thread(target=feed, daemon=True).start()
                deadline = time.monotonic() + timeout
                while True:
                    left = deadline - time.monotonic()
                    if left <= 0:
                        raise subprocess.TimeoutExpired(argv, timeout)
                    try:
                        proc.wait(timeout=min(WATCH_POLL, left))
                        break
                    except subprocess.TimeoutExpired:
                        why = watch()
                        if why:
                            _kill_group(proc)
                            stopped = True
                            if info is not None:
                                info["stopped"] = why
                            break
        except subprocess.TimeoutExpired:
            _kill_group(proc)
            raise RuntimeError(f"timed out after {timeout}s")
        except BaseException:
            # Ctrl-C or a signal to a foreground run: do not orphan the child
            # (it is in its own session and would keep running and billing).
            _kill_group(proc)
            raise
    if not stopped and _group_alive(proc.pid):
        # The child exited but left something in its group: clean it up.
        _kill_group(proc)
    return proc.returncode


def _group_alive(pgid):
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    return True


def _kill_group(proc):
    """SIGTERM the group, give the whole group (not just the direct child)
    a grace period, then SIGKILL whatever is left and reap the child."""
    for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            try:
                proc.wait(0.2)
            except subprocess.TimeoutExpired:
                pass
            if proc.poll() is not None and not _group_alive(proc.pid):
                return
            time.sleep(0.2)
    try:
        proc.wait(1)
    except subprocess.TimeoutExpired:
        pass


def run_codex(run_dir, prompt, o):
    last = os.path.join(run_dir, "result.raw.md")
    if os.path.exists(last):
        os.unlink(last)   # never accept a stale final message
    argv = ["codex", "exec", "-", "-s", "read-only", "-C", o["cwd"],
            "--ephemeral", "--color", "never", "-o", last,
            "-c", "project_doc_max_bytes=0"]   # no AGENTS.md in the reviewer's context
    if o["effort"]:
        argv += ["-c", f"model_reasoning_effort={o['effort']}"]
    if o["model"]:
        argv += ["-m", o["model"]]
    cfg_model = codex_defaults()   # read before launch: what the CLI was configured with
    rc = _run_cli(run_dir, argv, prompt, o["cwd"], o["timeout"])
    if rc != 0:
        raise RuntimeError(f"codex exec exited {rc}; see stderr.log")
    text = open(last).read() if os.path.exists(last) else ""
    if not text.strip():
        raise RuntimeError("codex exited 0 but wrote no final message (result.raw.md empty)")
    # codex reports no served model; the config default is evidence of the
    # request, not of what was served, so it goes under extra.
    return {"result_text": text, "usage": None, "model": o["model"] or "(codex default)",
            "raw_status": f"exit {rc}", "extra": {"codex_config_at_launch": cfg_model}}


AGY_PRO_RE = re.compile(r"^(gemini-[\d.]+-pro)(?:-(low|medium|high))?$")
_AGY_ERROR_RE = re.compile(r"AGY_ERROR:\s*(\{.*\})")
AGY_SETTINGS = os.environ.get(
    "ANTAGONIST_AGY_SETTINGS", os.path.join(HOME, ".gemini", "antigravity-cli", "settings.json"))
AGY_AGENT = "antagonist-reviewer"
AGY_READ_TOOLS = ["view_file", "grep_search", "find_by_name", "list_dir"]
# A command's whole output when agy's sandbox cannot start. Anchored at the
# start: a reviewer that prints this phrase from a file it is reading (the
# runner's own source, a README) has a working sandbox.
AGY_SANDBOX_DOWN = "connecting to sandbox server"
_AGY_SANDBOX_DOWN_RE = re.compile(
    r"\s*(?:Encountered error in tool execution:\s*)?" + re.escape(AGY_SANDBOX_DOWN))


class AgyRetryable(RuntimeError):
    """A failure that a second attempt can cure (interrupted stream)."""


AGY_QUOTA_RE = re.compile(r"RESOURCE_EXHAUSTED|\b429\b|quota exceeded", re.I)


def agy_tools_mode(requested):
    """(mode, why). `exec` needs agy's own settings to let sandboxed commands
    run unprompted; headless agy refuses every command otherwise."""
    if requested in ("read", "exec"):
        return requested, "requested"
    st = read_json(AGY_SETTINGS, {}) or {}
    if st.get("toolPermission") == "proceed-in-sandbox":
        return "exec", "agy settings: toolPermission = proceed-in-sandbox"
    return "read", ("agy settings lack toolPermission = proceed-in-sandbox; "
                    "shell commands would be refused")


# Where agy's terminal sandbox lets commands write (measured on agy 1.2.14).
AGY_SANDBOX_WRITABLE = ["/tmp", "/var/tmp", os.path.join(HOME, ".cache")]


def agy_sandbox_writable(path):
    """The writable root that holds `path`, or None."""
    real = os.path.realpath(path)
    for root in AGY_SANDBOX_WRITABLE:
        r = os.path.realpath(root)
        common = os.path.commonpath([real, r])
        if common in (real, r):   # path inside the root, or the root inside the path
            return root
    return None


def agy_masked_argv(agy_argv, mask):
    """Wrap agy in bubblewrap with each existing `mask` path replaced by an
    empty tmpfs (directory) or /dev/null (file). Root is bound read-write and
    the network is shared, so agy behaves as before; only the masked paths
    differ. Returns (argv, masked paths). PRE: nested user namespaces work on
    the host (agy builds its own sandbox inside); measured 2026-10-02."""
    paths = [os.path.expanduser(m) for m in mask]
    present = [m for m in paths if os.path.exists(m)]
    if not present:
        return list(agy_argv), []
    bwrap, _ = find_binary("bwrap")
    if not bwrap:
        raise RuntimeError("bwrap (bubblewrap) not found, so these paths cannot be hidden from "
                           f"agy's sandbox: {', '.join(present)}; install it, or set [agy] mask = [] "
                           "to accept that a reviewer can read them")
    argv = [bwrap, "--dev-bind", "/", "/", "--die-with-parent"]
    for m in present:
        argv += ["--tmpfs", m] if os.path.isdir(m) else ["--ro-bind", "/dev/null", m]
    return argv + ["--"] + list(agy_argv), present


def agy_environment(exe):
    """Notes on host conditions that stop agy's sandbox. Reads only."""
    notes = []
    try:
        restricted = open("/proc/sys/kernel/apparmor_restrict_unprivileged_userns").read().strip() == "1"
    except OSError:
        restricted = False
    if restricted and exe:
        found = False
        for prof in glob.glob("/etc/apparmor.d/*"):
            try:
                if os.path.isfile(prof) and exe in open(prof, errors="replace").read():
                    found = True
                    break
            except OSError:
                continue
        if not found:
            notes.append(f"this kernel restricts unprivileged user namespaces and no AppArmor "
                         f"profile under /etc/apparmor.d names {exe}: agy's sandbox cannot start")
    return notes


def agy_agent_text(mode, web):
    """exec: the sandboxed shell is the only way to files, so every read goes
    through the sandbox's own masking and no file-tool refusal can occur.
    read: agy's file tools, confined to the attached directories."""
    tools = ["run_command"] if mode == "exec" else list(AGY_READ_TOOLS)
    if web:
        tools.append("search_web")
    body = ("You are an independent reviewer. You can "
            + ("run shell commands inside a sandbox and read files through it"
               if mode == "exec" else "read and search files")
            + (", and search the web" if web else "")
            + ". You have no tool that modifies files and must not try to modify anything. "
              "Answer in your reply text.")
    return ("---\n"
            f"name: {AGY_AGENT}\n"
            "description: Independent reviewer; reads, searches"
            + (", runs sandboxed checks" if mode == "exec" else "") + "; cannot modify files.\n"
            "tools:\n" + "".join(f"  - {t}\n" for t in tools)
            + "mainAgent: true\nsubagent: false\nmodel: inherit\n"
            f"commandExecutionPolicy: {'sandbox' if mode == 'exec' else 'off'}\n"
            "---\n" + body + "\n")


def agy_workspace(run_dir, mode, web):
    """A workspace that holds only the reviewer agent. The material under
    review is attached with --add-dir, so nothing is written into it."""
    ws = os.path.join(run_dir, "ws")
    adir = os.path.join(ws, ".agents", "agents")
    os.makedirs(adir, mode=0o700, exist_ok=True)
    write_text_atomic(os.path.join(adir, AGY_AGENT + ".md"), agy_agent_text(mode, web))
    return ws


def _agy_short_error(run_dir):
    """(': <first line of agy's own short_error>' or '', retryable) from stderr.log."""
    try:
        text = open(os.path.join(run_dir, "stderr.log"), errors="replace").read()
    except OSError:
        return "", False
    for m in reversed(_AGY_ERROR_RE.findall(text)):
        try:
            obj = json.loads(m)
        except ValueError:
            continue
        short = (obj.get("short_error") or "").strip().splitlines()
        if short:
            return ": " + short[0][:200], bool(obj.get("retryable"))
    return "", False


class AgyStream:
    """State of one agy stream-json log, fed line by line.
    steps: [index, step_type, text] in order of first appearance; text is the
    step's accumulated text_delta. active: indexes seen ACTIVE and not DONE."""

    def __init__(self):
        self.result, self.tools, self.steps, self.active = None, [], [], set()
        self.usage, self.conversation_id, self.last_done = {}, None, None
        self.last_event = None   # (step, state) of the newest step_update
        self._by_index, self._done = {}, set()

    def feed(self, raw):
        raw = raw.strip()
        if not raw:
            return
        try:
            ev = json.loads(raw)
        except json.JSONDecodeError:
            return
        if not isinstance(ev, dict):
            return
        if ev.get("event") == "result" and isinstance(ev.get("result"), dict):
            self.result = ev["result"]
            return
        su = ev.get("step_update") if ev.get("event") == "step_update" else None
        if not isinstance(su, dict):
            return
        self.conversation_id = su.get("conversation_id") or self.conversation_id
        idx = su.get("step_index")
        step = self._by_index.get(idx) if idx is not None else None
        if (step is None and idx is None and self.last_event is not None
                and self.last_event[1] != "DONE"
                and su.get("step_type") in (None, self.last_event[0][1])):
            step = self.last_event[0]   # no index: the step still being streamed
        if step is None:
            step = [idx, su.get("step_type"), ""]
            self.steps.append(step)
            if idx is not None:
                self._by_index[idx] = step
        if isinstance(su.get("text_delta"), str):
            step[2] += su["text_delta"]
        self.last_event = (step, su.get("state"))
        if su.get("state") == "DONE":
            self.active.discard(idx)
            self.last_done = step
            self._done.add(id(step))
            if isinstance(su.get("tool_info"), dict):
                ti = su["tool_info"]
                self.tools.append((str(ti.get("name")), str(ti.get("output") or "")))
            for k, v in (su.get("usage") or {}).items():
                if isinstance(v, (int, float)):
                    self.usage[k] = self.usage.get(k, 0) + v
        elif su.get("state") == "ACTIVE":
            self.active.add(idx)

    def answer(self):
        """(answer, trailing). The answer is every agent_response text up to
        and including the longest one, plus later ones that no system message
        precedes. Text agy adds after its answer when a background command
        reports back is `trailing`, not part of the review."""
        texts = [(pos, s[2]) for pos, s in enumerate(self.steps)
                 if s[1] == "agent_response" and s[2].strip()]
        if not texts:
            return "", ""
        main = max(reversed(texts), key=lambda t: len(t[1]))[0]   # the later of two equals
        kept, trailing, cut = [], [], False
        for pos, text in texts:
            if pos > main and not cut:
                cut = any(s[1] == "system_message" for s in self.steps[main + 1:pos])
            (trailing if cut else kept).append(text)
        return "".join(kept), "".join(trailing)

    def answer_complete(self):
        """An answer of usable length whose longest reply was closed by a DONE
        event and was not followed by a tool call: a reply that goes on to run
        a command (a plan, then a hung command) is work in progress, whatever
        its length."""
        texts = [(pos, s) for pos, s in enumerate(self.steps) if s[1] == "agent_response" and s[2].strip()]
        if not texts:
            return False
        pos, main = max(reversed(texts), key=lambda t: len(t[1][2]))
        if any(s[1] == "tool" for s in self.steps[pos + 1:]):
            return False
        return id(main) in self._done and len(self.answer()[0].strip()) >= AGY_ANSWER_MIN


def agy_stream(run_dir, name="stdout.log"):
    st = AgyStream()
    try:
        fh = open(os.path.join(run_dir, name), errors="replace")
    except OSError:
        return st
    with fh:
        for raw in fh:
            st.feed(raw)
    return st


def agy_events(run_dir, name="stdout.log"):
    """(result or None, tool calls as [(name, output text)]) from a stream log."""
    st = agy_stream(run_dir, name)
    return st.result, st.tools


AGY_ANSWER_MIN = 200   # characters; shorter text is not taken for a finished answer
AGY_TRAILING_MARK = ("---\n[antagonist: agy added the text below after its answer, when a "
                     "background command reported back; read it as an addendum, not as the review]")


class AgyWatch:
    """Watch function for _run_cli; returns a reason to end the run, or None.
    linger: agy keeps a turn open after its answer while a command the
    reviewer started is still running (seen: one that reads a terminal that
    never sends), and emits its result event only when --print-timeout
    expires: answer at 8 min, exit at 60. CAVEAT: a reviewer that answers and
    then waits longer than `linger` for a command in order to add to its
    answer loses that addition.
    stall: `stall` seconds of silence with no complete answer is reported as
    STALLED, for the caller to retry; with a complete answer it ends the turn
    like linger. A safeguard: no stall of agy's own has been observed (the
    one seen was this runner not delivering stdin).
    PRE: stall is longer than the longest silent model step or command a
    review may legitimately contain."""

    STALLED = "agy went silent"

    def __init__(self, path, linger, stall=0):
        self.path, self.linger, self.stall = path, linger, stall
        self.stream, self.offset, self.buf = AgyStream(), 0, b""
        self.last_output = time.monotonic()

    def __call__(self):
        try:
            with open(self.path, "rb") as fh:
                fh.seek(self.offset)
                chunk = fh.read()
                self.offset = fh.tell()
        except OSError:
            return None
        if chunk:
            self.last_output = time.monotonic()
            lines = (self.buf + chunk).split(b"\n")
            self.buf = lines.pop()   # an incomplete last line waits for its newline
            for line in lines:
                self.stream.feed(line.decode("utf-8", errors="replace"))
        st = self.stream
        quiet = time.monotonic() - self.last_output
        if st.result is not None:
            return None
        if self.linger > 0 and quiet >= self.linger and st.last_event is not None:
            step, state = st.last_event
            # The newest event closes a reply and no tool call followed it:
            # nothing is in flight. A command left running from earlier (still
            # ACTIVE) is what agy is waiting for, so `active` is not consulted.
            if state == "DONE" and step[1] == "agent_response" and st.answer_complete():
                return f"agy held the turn open {int(quiet)}s after its answer"
        if self.stall > 0 and quiet >= self.stall:
            if st.answer_complete():   # e.g. a tool event arrived after the answer
                return f"agy held the turn open {int(quiet)}s after its answer"
            return f"{self.STALLED} for {int(quiet)}s with no complete answer in the stream"
        return None


_FENCE_OPEN_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
_FENCE_CLOSE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})\s*$")


class Fences:
    """Line-by-line code-fence state: ``` or ~~~, closed only by a fence of
    the same character and at least the same length."""

    def __init__(self):
        self.open = None   # (character, length) while inside a block

    def feed(self, line):
        """True when the line is a fence line or lies inside a block."""
        if self.open is None:
            m = _FENCE_OPEN_RE.match(line)
            # a backtick fence may not carry a backtick in its info string:
            # ```code``` at the start of a line is an inline span
            if m and not (m.group(1)[0] == "`" and "`" in m.group(2)):
                self.open = (m.group(1)[0], len(m.group(1)))
                return True
            return False
        m = _FENCE_CLOSE_RE.match(line)
        if m and m.group(1)[0] == self.open[0] and len(m.group(1)) >= self.open[1]:
            self.open = None
        return True


def looks_truncated(text):
    """The text stops inside a fenced code block."""
    f = Fences()
    for line in text.splitlines():
        f.feed(line)
    return f.open is not None


AGY_NUDGE = {
    "read_file": "the file tools cannot read that path; use what the prompt gives you",
    "unsandboxed": "nothing may run outside the sandbox",
    "command": "shell commands are not available in this session",
    "read_url": "pages cannot be fetched in this session",
}


def agy_nudge_text(denied):
    acts = sorted({str(d.get("action")) for d in denied if isinstance(d, dict)})
    why = "; ".join(AGY_NUDGE.get(a, f"`{a}` is not available") for a in acts)
    return (f"Your last tool request was refused ({why}) and would be refused again; do not "
            "repeat it. Continue with the tools that work and give your complete final answer.")


def _run_agy_once(run_dir, prompt, o):
    """One attempt: the prompt, then up to `nudges` corrective turns in the
    same conversation when agy ends a turn empty because a tool was refused
    (headless agy cannot ask, so a refusal otherwise costs the whole run)."""
    model, effort = o["model"], o["effort"]
    mode = o.get("agy_tools") or "read"
    ws = agy_workspace(run_dir, mode, bool(o.get("agy_web")))
    agy_exe, _ = find_binary("agy")
    if not agy_exe:
        raise RuntimeError("agy: binary not found on PATH or in fallback dirs")
    base = [agy_exe, "-p", "", "--input-format", "stream-json",
            "--output-format", "stream-json", "--sandbox", "--agent", AGY_AGENT,
            "--print-timeout", f"{max(60, o['timeout'])}s"]
    for d in [o["cwd"]] + list(o.get("read_dirs") or []):
        base += ["--add-dir", d]
    effective = effort
    m = AGY_PRO_RE.match(model or "")
    if m:
        # Pro models carry effort in the slug and offer only low|high.
        eff = effort or m.group(2) or "high"
        eff = "high" if eff == "medium" else eff
        model, effective = f"{m.group(1)}-{eff}", eff
    elif effort:
        base += ["--effort", effort]
    if model:
        base += ["--model", model]
    nudges = max(0, int(o.get("nudges", 2)))
    linger, stall = float(o.get("linger") or 0), float(o.get("stall") or 0)
    base, masked = agy_masked_argv(base, o.get("mask") or [])
    text, stdin_name, argv = prompt, "prompt.agy.jsonl", list(base)
    tools, denied_all, turn, notes = [], [], 0, []
    while True:
        line = json.dumps({"event": "user", "message": {"content": text}}) + "\n"
        info = {}
        watch = (AgyWatch(os.path.join(run_dir, "stdout.log"), linger, stall)
                 if linger > 0 or stall > 0 else None)
        # JAVA_HOME: with it set, agy's sandbox tries to add its certificate to the
        # JVM trust store, finds it read-only, and exits; every command then fails.
        rc = _run_cli(run_dir, argv, line, ws, o["timeout"] + 30,
                      stdin_name=stdin_name, env_drop=("JAVA_HOME",), watch=watch, info=info)
        stream = agy_stream(run_dir)
        result = stream.result
        tools += stream.tools
        answer, trailing = stream.answer()
        if str(info.get("stopped") or "").startswith(AgyWatch.STALLED):
            raise AgyRetryable(info["stopped"])
        if info.get("stopped"):
            rc = 0   # ended by the runner: the exit status is the kill, not agy's verdict
            if result is None or not (result.get("response") or "").strip():
                # No result event, or one emptied by the kill: the answer is what agy streamed.
                if len(answer.strip()) < AGY_ANSWER_MIN:
                    raise AgyRetryable(f"{info['stopped']}, and the stream holds no answer")
                result = {"status": "SUCCESS", "response": answer + trailing,
                          "usage": stream.usage or None,
                          "conversation_id": stream.conversation_id}
                notes.append(f"{info['stopped']}; ended by the runner, answer taken from the stream")
            else:
                notes.append(f"{info['stopped']}; ended by the runner as agy reported its result")
        if trailing and result and (answer + trailing).strip() == (result.get("response") or "").strip():
            # Kept in the result, below a marker, so a conclusion that arrived
            # late is never hidden from the reader; the file holds it alone.
            write_text_atomic(os.path.join(run_dir, "result.trailing.md"), trailing)
            notes.append(f"{len(trailing)} characters agy added after its answer follow the "
                         "marker at the end of the result (also in result.trailing.md)")
            result = dict(result, response=answer.rstrip() + "\n\n" + AGY_TRAILING_MARK + "\n"
                          + trailing.strip() + "\n")
        if rc != 0:
            short, retryable = _agy_short_error(run_dir)
            if not short:
                # agy's own model catalog is fetched at start; when that fetch fails
                # it rejects a slug it serves in the part running next to this one.
                tail = open(os.path.join(run_dir, "stderr.log"), errors="replace").read()[-2000:]
                if "not recognized as a known model" in tail:
                    retryable, short = True, ": a model it serves was 'not recognized' (catalog fetch failed?)"
            raise (AgyRetryable if retryable else RuntimeError)(
                f"agy exited {rc}{short}; see stderr.log")
        if result is None:
            raise AgyRetryable("agy produced no result event; see stdout.log/stderr.log")
        if result.get("status") != "SUCCESS":
            # agy can exit 0 with status ERROR and a complete-looking response.
            msg = f"agy status {result.get('status')}: {result.get('error')}"
            raise (RuntimeError if "invalid model" in str(result.get("error")).lower()
                   else AgyRetryable)(msg)   # a 429 quota error is retried after a pause (run_agy)
        denied = result.get("denied_actions") or []
        denied_all += denied
        if (result.get("response") or "").strip():
            break
        # SUCCESS with an empty response is agy's shape for a soft-denied tool.
        cid = result.get("conversation_id") or stream.conversation_id
        if not (denied and cid and turn < nudges):
            note = open(os.path.join(run_dir, "stderr.log"), errors="replace").read().strip()
            what = ", ".join(sorted({str(d.get("action")) for d in denied_all if isinstance(d, dict)}))
            raise RuntimeError("agy returned an empty response (a tool was denied in headless "
                               f"mode{': ' + what if what else ''}"
                               f"{f', after {turn} corrective turns' if turn else ''}): "
                               f"{note.splitlines()[0][:300] if note else 'no stderr'}")
        turn += 1
        for name in ("stdout.log", "stderr.log", "cmd.txt"):
            src = os.path.join(run_dir, name)
            if os.path.exists(src):
                os.replace(src, f"{src}.turn{turn}")
        text, stdin_name = agy_nudge_text(denied), f"nudge{turn}.agy.jsonl"
        argv = list(base) + ["--conversation", cid]
    if any(_AGY_SANDBOX_DOWN_RE.match(out) for name, out in tools if name == "run_command"):
        raise RuntimeError("agy sandbox failed to start: its shell commands returned "
                           f"'{AGY_SANDBOX_DOWN} ...', so nothing was verified by execution")
    counts = {}
    for name, _ in tools:
        counts[name] = counts.get(name, 0) + 1
    return {"result_text": result["response"], "usage": result.get("usage"),
            "model": model or "(agy default)", "raw_status": result.get("status"),
            "extra": {"conversation_id": result.get("conversation_id"),
                      "num_turns": result.get("num_turns"), "effective_effort": effective,
                      "tools_mode": mode, "tool_calls": counts, "denied_actions": denied_all,
                      "corrective_turns": turn, "notes": notes, "masked": masked}}


def run_agy(run_dir, prompt, o):
    """One retry by default: long tool-using turns sometimes end with an
    interrupted stream. The failed attempt's logs are kept as *.tryN."""
    attempts = 1 + max(0, int(o.get("retries") or 0))
    for i in range(1, attempts + 1):
        try:
            out = _run_agy_once(run_dir, prompt, o)
            out["extra"]["attempts"] = i
            return out
        except AgyRetryable as exc:
            if i == attempts:
                raise RuntimeError(f"{exc}" + (f" (after {attempts} attempts)" if attempts > 1 else ""))
            if AGY_QUOTA_RE.search(str(exc)):
                # a per-minute request quota: retrying at once fails the same way
                time.sleep(float(o.get("quota_pause", 65)))
            for pat in ("std*.log*", "cmd.txt*", "nudge*.agy.jsonl", "result.trailing.md"):
                for src in glob.glob(os.path.join(run_dir, pat)):
                    if ".try" not in os.path.basename(src):
                        os.replace(src, f"{src}.try{i}")


def run_claude(run_dir, prompt, o):
    # --safe-mode drops CLAUDE.md, hooks, plugins, MCP, skills; plan mode plus a
    # read-only tool list keeps it from editing. --bare is not used: it skips
    # the credential store and the run fails with "Not logged in".
    argv = ["claude", "-p", "--output-format", "json", "--permission-mode", "plan",
            "--tools", "Read,Grep,Glob", "--no-session-persistence",
            "--safe-mode", "--strict-mcp-config", "--disable-slash-commands"]
    if o["effort"]:
        argv += ["--effort", o["effort"]]
    if o["model"]:
        argv += ["--model", o["model"]]
    rc = _run_cli(run_dir, argv, prompt, o["cwd"], o["timeout"])
    raw = open(os.path.join(run_dir, "stdout.log"), errors="replace").read()
    try:
        d = json.loads(raw)
    except json.JSONDecodeError:
        raise RuntimeError(f"claude -p output was not JSON (exit {rc}); see stdout.log")
    if rc != 0:
        raise RuntimeError(f"claude -p exited {rc}: {str(d.get('result'))[:300]}")
    if d.get("is_error"):
        raise RuntimeError(f"claude -p error: {str(d.get('result'))[:300]}")
    if not (d.get("result") or "").strip():
        raise RuntimeError("claude -p returned an empty result")
    return {"result_text": d["result"], "usage": d.get("usage"),
            "model": ",".join((d.get("modelUsage") or {}).keys()) or o["model"] or "(claude default)",
            "raw_status": d.get("subtype"),
            "extra": {"num_turns": d.get("num_turns"), "total_cost_usd": d.get("total_cost_usd"),
                      "duration_ms": d.get("duration_ms")}}


class RedirectRefused(RuntimeError):
    """Raised instead of following a redirect on an authenticated request. The
    message names the target; it is response-controlled, so callers that
    record errors must keep the class, not the text."""


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise RedirectRefused(f"refusing to follow HTTP {code} redirect to {newurl}")


def _check_endpoint(base_url, authenticated):
    parts = urllib.parse.urlsplit(base_url)
    if authenticated and parts.scheme != "https" and parts.hostname not in (
            "127.0.0.1", "localhost", "::1"):
        raise RuntimeError(f"refusing to send a credential over plain http to {base_url}")


_CREDIT_TOKEN_RE = re.compile(r'("fallback_credit_token"\s*:\s*")[^"]*(")')


def _sse_post(url, headers, body, idle_timeout, log_path, on_event, redact=lambda s: s):
    """POST and stream SSE. Writes each line to log_path after `redact` and
    after scrubbing response-issued tokens. Returns True if the server ended
    the stream with `[DONE]`, else False (plain EOF). Any `data:` payload that
    is not valid JSON fails the run: a damaged stream is not a review.
    `idle_timeout` bounds silence per socket read; the worker's alarm bounds
    the wall clock."""
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                 headers={"Content-Type": "application/json", **headers})
    opener = urllib.request.build_opener(_NoRedirect)
    try:
        resp = opener.open(req, timeout=idle_timeout)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:1000]
        raise RuntimeError(f"HTTP {exc.code} from {url}: {detail}")
    except TimeoutError:
        raise RuntimeError(f"no response from {url} within idle timeout {idle_timeout}s")
    done_marker = False
    event_name = None
    malformed = 0
    with resp, open(log_path, "w") as log:
        while True:
            try:
                raw = resp.readline()
            except TimeoutError:
                raise RuntimeError(f"stream from {url} went silent for {idle_timeout}s")
            if not raw:
                break
            try:
                line = raw.decode("utf-8").rstrip("\r\n")
            except UnicodeDecodeError:
                malformed += 1
                log.write("<undecodable line>\n")
                continue
            log.write(redact(_CREDIT_TOKEN_RE.sub(r"\1<redacted>\2", line)) + "\n")
            if line.startswith("event:"):
                event_name = line[6:].strip()
            elif line.startswith("data:"):
                data = line[5:].strip()
                if data == "[DONE]":
                    done_marker = True
                    break
                try:
                    payload = json.loads(data)
                except json.JSONDecodeError:
                    malformed += 1
                    continue
                on_event(event_name, payload)
            elif line == "":
                event_name = None
    if malformed:
        raise RuntimeError(f"stream carried {malformed} malformed line(s); response not trusted")
    return done_marker


def run_anthropic(run_dir, prompt, o):
    key = read_key_file(o["key_file"]) or os.environ.get("ANTHROPIC_API_KEY")
    if not key:
        raise RuntimeError("no API key: set key_file in config or ANTHROPIC_API_KEY")
    _check_endpoint(o["base_url"], True)
    body = {
        "model": o["model"], "max_tokens": int(o["max_tokens"]), "stream": True,
        "thinking": {"type": "adaptive", "display": "omitted"},
        "messages": [{"role": "user", "content": prompt}],
    }
    if o["effort"]:
        body["output_config"] = {"effort": o["effort"]}
    headers = {"x-api-key": key, "anthropic-version": "2023-06-01"}
    if o.get("fallbacks"):
        body["fallbacks"] = "default"
        headers["anthropic-beta"] = "server-side-fallback-2026-07-01"
    _write_api_cmd(run_dir, f"{o['base_url']}/v1/messages", body,
                   "anthropic-version, x-api-key: <redacted>"
                   + (", anthropic-beta: " + headers["anthropic-beta"]
                      if "anthropic-beta" in headers else ""))
    text, thinking = [], []
    st = {"model": None, "stop_reason": None, "usage": {}, "fallbacks": [],
          "stop_details": None, "message_start": False, "message_stop": False}

    def on_event(name, d):
        t = d.get("type")
        if t == "message_start":
            st["message_start"] = True
            st["model"] = d["message"].get("model")
            st["usage"].update(d["message"].get("usage") or {})
        elif t == "content_block_start":
            cb = d.get("content_block", {})
            if cb.get("type") == "fallback":
                st["fallbacks"].append(cb)
                st["model"] = (cb.get("to") or {}).get("model") or st["model"]
        elif t == "content_block_delta":
            delta = d.get("delta", {})
            if delta.get("type") == "text_delta":
                text.append(delta.get("text", ""))
            elif delta.get("type") == "thinking_delta":
                thinking.append(delta.get("thinking", ""))
        elif t == "message_delta":
            delta = d.get("delta", {})
            st["stop_reason"] = delta.get("stop_reason")
            st["stop_details"] = delta.get("stop_details")
            st["usage"].update(d.get("usage") or {})
        elif t == "message_stop":
            st["message_stop"] = True
        elif t == "error":
            raise RuntimeError(f"API stream error: {json.dumps(d)[:500]}")

    _sse_post(f"{o['base_url'].rstrip('/')}/v1/messages", headers, body,
              o["idle_timeout"], os.path.join(run_dir, "stdout.log"), on_event,
              redact=o.get("_redact", lambda s: s))
    if not (st["message_start"] and st["message_stop"] and st["stop_reason"]):
        raise RuntimeError("stream incomplete: needs message_start, message_delta with a "
                           f"stop_reason, and message_stop (got stop_reason={st['stop_reason']}, "
                           f"start={st['message_start']}, stop={st['message_stop']})")
    if st["stop_reason"] == "refusal":
        details = dict(st["stop_details"] or {})
        details.pop("fallback_credit_token", None)   # a capability, never persisted
        raise RuntimeError(f"model refused: {json.dumps(details)}")
    body_text = "".join(text)
    if not has_visible_text(body_text):
        raise RuntimeError(f"no visible text in response (stop_reason={st['stop_reason']})")
    if st["stop_reason"] in ("max_tokens", "model_context_window_exceeded"):
        body_text += f"\n\n[antagonist: output truncated: stop_reason={st['stop_reason']}]"
    if any(thinking):
        with open(os.path.join(run_dir, "reasoning.md"), "w") as fh:
            fh.write("".join(thinking))
    iter_fallback = any((it or {}).get("type") == "fallback_message"
                        for it in (st["usage"].get("iterations") or []))
    return {"result_text": body_text, "usage": st["usage"], "model": st["model"],
            "raw_status": st["stop_reason"],
            "extra": {"requested_model": o["model"], "fallbacks": st["fallbacks"],
                      "served_by_fallback": bool(st["fallbacks"]) or iter_fallback}}


def _write_api_cmd(run_dir, url, body, header_note):
    redacted = dict(body)
    redacted["messages"] = "[prompt.md]"
    with open(os.path.join(run_dir, "cmd.txt"), "w") as fh:
        fh.write(f"POST {url}\nheaders: {header_note}\n" + json.dumps(redacted, indent=2) + "\n")
    open(os.path.join(run_dir, "stderr.log"), "w").close()


def run_openai_compat(run_dir, prompt, o, provider):
    key = read_key_file(o["key_file"]) if o.get("key_file") else None
    if provider == "moonshot" and not key:
        key = os.environ.get("MOONSHOT_API_KEY")
        if not key:
            raise RuntimeError("no API key: set key_file in config or MOONSHOT_API_KEY")
    model = (o["model"] or "").strip()
    if not model:
        raise RuntimeError(f"{provider}: --model is required (no default)")
    _check_endpoint(o["base_url"], bool(key))
    body = {"model": model, "stream": True,
            "messages": [{"role": "user", "content": prompt}],
            "stream_options": {"include_usage": True}}
    # Moonshot documents max_completion_tokens; ollama documents max_tokens.
    body["max_completion_tokens" if provider == "moonshot" else "max_tokens"] = int(o["max_tokens"])
    if o["effort"]:
        body["reasoning_effort"] = o["effort"]
    headers = {"Authorization": f"Bearer {key}"} if key else {}
    _write_api_cmd(run_dir, f"{o['base_url']}/chat/completions", body,
                   "Authorization: Bearer <redacted>" if key else "(none)")
    text, reasoning = [], []
    st = {"model": None, "finish": None, "usage": None}

    def on_event(_name, d):
        if d.get("error"):
            raise RuntimeError(f"API error: {json.dumps(d)[:500]}")
        st["model"] = d.get("model") or st["model"]
        if d.get("usage"):
            st["usage"] = d["usage"]
        for ch in d.get("choices") or []:
            delta = ch.get("delta") or {}
            if delta.get("content"):
                text.append(delta["content"])
            if delta.get("reasoning_content"):
                reasoning.append(delta["reasoning_content"])
            if ch.get("finish_reason"):
                st["finish"] = ch["finish_reason"]

    done = _sse_post(f"{o['base_url'].rstrip('/')}/chat/completions", headers, body,
                     o["idle_timeout"], os.path.join(run_dir, "stdout.log"), on_event,
                     redact=o.get("_redact", lambda s: s))
    if reasoning:
        with open(os.path.join(run_dir, "reasoning.md"), "w") as fh:
            fh.write("".join(reasoning))
    if not done and not st["finish"]:
        raise RuntimeError("stream ended without [DONE] or a finish_reason; response incomplete")
    if st["finish"] not in (None, "stop", "length"):
        raise RuntimeError(f"finish_reason={st['finish']}")
    body_text = "".join(text)
    if not has_visible_text(body_text):
        raise RuntimeError(f"no visible text in response (finish_reason={st['finish']})")
    if st["finish"] == "length":
        body_text += "\n\n[antagonist: output truncated at max tokens]"
    return {"result_text": body_text, "usage": st["usage"], "model": st["model"],
            "raw_status": st["finish"] or "[DONE]"}


