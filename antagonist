# ---------------------------------------------------------------------- split
# One run per group of claims, in parallel, merged into one result. A reviewer
# given every claim at once spreads a fixed amount of reasoning across all of
# them; given two or three it tests each clause.

_CLAIMS_HEAD_RE = re.compile(r"^(#{1,6})\s+.*\bclaims?\b", re.I)
_HEAD_RE = re.compile(r"^(#{1,6})\s")
_CLAIM_ITEM_RE = re.compile(r"^(?:[-*+]\s+)?(?:\*\*)?([A-Za-z]{0,3}\d{1,3})[.)](?:\*\*)?(?:\s|$)")


def parse_claims(task):
    """Labels of the numbered items under the first heading that contains
    'claim', in order: `1.`, `2)`, `- **C3.**`. Items start at column 0 (an
    indented item is a sub-point of a claim); fenced blocks are skipped.
    Stops at the next heading of the same or a higher level, so claims may be
    grouped under deeper subheadings."""
    labels, level, fences = [], None, Fences()
    for line in task.splitlines():
        if fences.feed(line):
            continue
        h = _HEAD_RE.match(line)
        if level is None:
            m = _CLAIMS_HEAD_RE.match(line)
            if m:
                level = len(m.group(1))
            continue
        if h and len(h.group(1)) <= level:
            break
        m = _CLAIM_ITEM_RE.match(line)
        if m and m.group(1) not in labels:
            labels.append(m.group(1))
    return labels


def parse_split(spec, labels):
    """`auto` (groups of 3), `auto:N`, or explicit groups `1,2/3,4,7/*` where
    `*` takes every claim not named elsewhere. Every claim lands in exactly
    one group or the spec is refused."""
    spec = spec.strip()
    m = re.fullmatch(r"auto(?::(\d+))?", spec)
    if m:
        size = int(m.group(1) or 3)
        if size < 1:
            die("--split auto:N needs N >= 1")
        return [labels[i:i + size] for i in range(0, len(labels), size)]
    by_lower = {x.lower(): x for x in labels}
    groups, seen, star = [], set(), None
    for gi, chunk in enumerate(re.split(r"[/;]", spec)):
        names = [x.strip() for x in chunk.split(",") if x.strip()]
        if not names:
            die(f"--split: empty group in {spec!r}")
        if names == ["*"]:
            if star is not None:
                die("--split: `*` may appear once")
            star = gi
            groups.append(None)
            continue
        group = []
        for n in names:
            if n.lower() not in by_lower:
                die(f"--split: no claim labelled {n!r}; the prompt has {', '.join(labels)}")
            lab = by_lower[n.lower()]
            if lab in seen:
                die(f"--split: claim {lab} is in two groups")
            seen.add(lab)
            group.append(lab)
        groups.append(group)
    rest = [x for x in labels if x not in seen]
    if star is not None:
        if not rest:
            die("--split: `*` matches no remaining claim")
        groups[star] = rest
    elif rest:
        die(f"--split: claims not in any group: {', '.join(rest)} (add them, or a `*` group)")
    return groups


def scope_text(group):
    which = ("claim " if len(group) == 1 else "claims ") + ", ".join(group)
    return ("\n# Scope for this pass\n\n"
            f"This review is split into parts. Report ONLY on {which}; the other claims are "
            "reviewed by other parts and are context here, so a defect that needs one of them "
            "together with a claim in scope belongs in your report. Split each claim in scope into its separate "
            "clauses, test every clause against the evidence, and give a verdict per clause. "
            "Then list defects in the material relevant to these claims that the claims do not "
            "mention.\n")


def merge_parts(parts, metas, results):
    """One document: a status table, then each part's result in order."""
    out = [f"# Split review: {len(parts)} parts\n",
           "| part | claims | model | status | seconds | notes |", "|---|---|---|---|---|---|"]
    for i, (p, m) in enumerate(zip(parts, metas), 1):
        notes = "; ".join((m.get("extra") or {}).get("notes") or []).replace("|", "/")
        out.append(f"| {i:02d} | {', '.join(p['claims'])} | {m.get('model_served') or p.get('model') or ''} "
                   f"| {m.get('status')} | {m.get('duration_s') or ''} | {notes} |")
    for i, (p, m, text) in enumerate(zip(parts, metas, results), 1):
        out.append(f"\n---\n\n# Part {i:02d} of {len(parts)}: claims {', '.join(p['claims'])}"
                   f" ({m.get('model_served') or p.get('model') or 'default model'})\n")
        out.append(text.rstrip() if text is not None
                   else f"[antagonist: this part failed: {m.get('error')}]")
    return "\n".join(out) + "\n"


def new_run_dir(backend, label):
    os.makedirs(RUNS_ROOT, mode=0o700, exist_ok=True)
    os.chmod(RUNS_ROOT, 0o700)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    name = f"{stamp}-{backend}" + (f"-{re.sub(r'[^A-Za-z0-9_.-]+', '-', label)}" if label else "")
    path = os.path.join(RUNS_ROOT, name)
    n = 1
    while os.path.exists(path):
        n += 1
        path = os.path.join(RUNS_ROOT, f"{name}-{n}")
    os.makedirs(path, mode=0o700)
    fsync_path(RUNS_ROOT)   # the directory entry itself must survive a crash
    return path


def cmd_run(args, cfg):
    backend = args.backend or cfg["default_backend"]
    if backend not in BACKENDS:
        die(f"unknown backend {backend!r}; one of {', '.join(BACKENDS)}")
    if bool(args.prompt_file) == bool(args.prompt):
        die("give exactly one of --prompt-file or --prompt")
    if args.timeout is not None and args.timeout <= 0:
        die("--timeout must be a positive number of seconds")
    if args.idle_timeout is not None and args.idle_timeout <= 0:
        die("--idle-timeout must be a positive number of seconds")
    cwd = os.path.abspath(args.cwd or os.getcwd())
    if not os.path.isdir(cwd):
        die(f"--cwd {cwd} is not a directory")
    if args.prompt_file:
        try:
            with open(args.prompt_file, encoding="utf-8", newline="") as fh:
                task = fh.read()
        except (OSError, UnicodeDecodeError) as exc:
            die(f"cannot read --prompt-file: {exc}")
    else:
        task = args.prompt
    if args.max_words is not None:
        if args.max_words <= 0:
            die("--max-words must be a positive integer")
        task = task.rstrip() + (f"\n\nAnswer in at most {args.max_words} words. Prefer fewer, "
                                "better-evidenced findings over completeness; stop when the budget "
                                "is spent rather than truncating a finding.\n")
    evidence = resolve_evidence(cwd, args.evidence)
    b = cfg[backend]
    model = (args.model or b.get("model") or "").strip() or None
    effort = norm_effort(backend, args.effort or b.get("effort"), model)
    opts = {
        "cwd": cwd, "model": model, "effort": effort,
        "timeout": int(args.timeout if args.timeout is not None else cfg.get("timeout", 3600)),
        "idle_timeout": int(args.idle_timeout if args.idle_timeout is not None
                            else cfg.get("idle_timeout", 300)),
        "key_file": b.get("key_file"), "base_url": b.get("base_url"),
        "max_tokens": b.get("max_tokens"),
        "fallbacks": (b.get("fallbacks", True) and not args.no_fallbacks),
    }
    ok, note = probe(backend, cfg, model=model)
    if not ok:
        die(f"backend {backend} unavailable: {note}")
    note_key = None
    if args.tools and backend != "agy":
        die("--tools applies to the agy backend only")
    read_dirs = [os.path.abspath(d) for d in args.read_dir]
    for d in read_dirs:
        if not os.path.isdir(d):
            die(f"--read-dir {d} is not a directory")
    if read_dirs and backend != "agy":
        print(f"antagonist: note: --read-dir is used by agy only; {backend} ignores it",
              file=sys.stderr)
    if backend == "agy":
        mode, why = agy_tools_mode(args.tools or b.get("tools") or "auto")
        note_key = f"agy:{mode}"
        opts.update(agy_tools=mode, agy_web=bool(b.get("web", True)),
                    retries=int(b.get("retries", 1)), nudges=int(b.get("nudges", 2)),
                    linger=float(b.get("linger", 180)), stall=float(b.get("stall", 600)),
                    quota_pause=float(b.get("quota_pause", 65)), mask=list(b.get("mask") or []),
                    read_dirs=read_dirs)
        print(f"antagonist: agy tools: {mode} ({why})", file=sys.stderr)
        if mode == "exec":
            for d in [cwd] + read_dirs:
                hit = agy_sandbox_writable(d)
                if hit:
                    die(f"{d} is under {hit}, where agy's sandbox lets commands write, so the "
                        "reviewer could change the material; use --tools read or review a copy "
                        "kept elsewhere")
            for n in agy_environment(find_binary("agy")[0]):
                print(f"antagonist: WARNING: {n}", file=sys.stderr)
    groups = None
    if args.split:
        labels = parse_claims(task)
        if not labels:
            die("--split found no numbered claims: it needs a numbered list under a "
                "heading that contains the word 'claims'")
        groups = parse_split(args.split, labels)
    elif args.also_model:
        die("--also-model needs --split")
    try:
        prompt = assemble_prompt(task, evidence, backend, cwd, preamble=not args.no_preamble,
                                 note_key=note_key, read_dirs=read_dirs)
    except ValueError as exc:
        die(str(exc))
    secrets = Secrets(cfg)
    hits = scan_for_secrets(prompt, secrets)
    for what, val in (("label", args.label), ("model", model), ("cwd", cwd),
                      ("base_url", opts["base_url"])):
        if val and scan_for_secrets(str(val), secrets):
            die(f"--{what} looks like it contains a credential")
    known = [h for h in hits if h[1] == "known credential value"]
    if known or (hits and not args.allow_secrets):
        lines = "\n".join(f"  prompt line {n}: {label}" for n, label in hits[:20])
        die("refusing to run: the assembled prompt contains credential-shaped text "
            f"(nothing was written):\n{lines}\n  Remove it from the prompt or evidence"
            + ("" if known else ", or pass --allow-secrets if these are known false positives")
            + ".")
    if backend == "codex" and FRAMING_WORDS.search(prompt):
        print("antagonist: note: prompt contains attack/bypass wording; codex's classifier "
              "has refused that framing before. Consider hardening-review phrasing.",
              file=sys.stderr)
    pre_notes, pre_at = [], None
    if preflight_enabled(args):
        try:
            pre = load_preflight(cfg, secrets, refresh=args.refresh)
            pre_at = pre.get("fetched_at")
            pre_notes = [secrets.redact(n) for n in preflight_notes(backend, model, pre)]
        except Exception as exc:  # noqa: BLE001
            pre_notes = [f"preflight unavailable ({exc.__class__.__name__}); run continues"]
        for n in pre_notes:
            print(f"antagonist: preflight: {n}", file=sys.stderr)
        if args.strict and pre_notes:
            die("refusing to run under --strict: see the preflight notes above")
    run_dir = new_run_dir(backend, args.label)
    write_text_atomic(os.path.join(run_dir, "prompt.md"), prompt)
    meta = {
        "backend": backend, "model": model, "effort": effort, "cwd": cwd,
        "evidence": evidence, "prompt_bytes": len(prompt.encode()), "label": args.label,
        "status": "queued", "worker_pid": None, "created_ns": time.time_ns(),
        "started": None, "finished": None, "duration_s": None,
        "timeout_s": opts["timeout"], "idle_timeout_s": opts["idle_timeout"],
        "error": None,
        "preflight": {"fetched_at": pre_at, "notes": pre_notes},
        "max_words": args.max_words,
    }
    if groups:
        os.makedirs(os.path.join(run_dir, "parts"), mode=0o700)
        plist = []
        for group in groups:
            for pm in [model] + [x.strip() for x in args.also_model if x.strip()]:
                rel = os.path.join("parts", f"{len(plist) + 1:02d}")
                pdir = os.path.join(run_dir, rel)
                os.makedirs(pdir, mode=0o700)
                ptext = assemble_prompt(task.rstrip() + "\n" + scope_text(group), evidence, backend,
                                        cwd, preamble=not args.no_preamble, note_key=note_key,
                                        read_dirs=read_dirs)
                write_text_atomic(os.path.join(pdir, "prompt.md"), ptext)
                popts = dict(opts, model=pm,
                             effort=norm_effort(backend, args.effort or b.get("effort"), pm))
                write_json(os.path.join(pdir, "opts.json"), popts)
                write_json(os.path.join(pdir, "meta.json"), dict(
                    meta, model=pm, effort=popts["effort"], claims=group,
                    prompt_bytes=len(ptext.encode())))
                plist.append({"dir": rel, "claims": group, "model": pm})
        meta["split"] = {"spec": args.split, "parts": plist,
                         "parallel": max(1, int(cfg.get("split_parallel", 6)))}
        print(f"antagonist: split into {len(plist)} parts: "
              + "; ".join(",".join(p["claims"]) + (f" [{p['model']}]" if args.also_model else "")
                          for p in plist), file=sys.stderr)
    write_json(os.path.join(run_dir, "meta.json"), meta)
    # opts.json carries the key file *path* (not a secret) so the worker does
    # not depend on the config file staying unchanged between spawn and start.
    write_json(os.path.join(run_dir, "opts.json"), opts)
    if args.detach:
        # The launcher never touches meta.json after the worker exists: the
        # worker owns it from here. The worker's identity goes to launcher.json.
        log = open(os.path.join(run_dir, "worker.log"), "ab")
        try:
            proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_worker", run_dir],
                                    stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                    start_new_session=True, close_fds=True)
        except OSError as exc:
            meta.update(status="failed", error=f"could not spawn worker: {exc}",
                        finished=now_iso())
            write_json(os.path.join(run_dir, "meta.json"), meta)
            die(f"could not spawn worker: {exc}", 1)
        write_json(os.path.join(run_dir, "launcher.json"),
                   {"worker_pid": proc.pid, "worker_start": proc_start(proc.pid)})
        print(run_dir, flush=True)
        return
    rc = worker(run_dir)
    if not args.quiet:
        res = os.path.join(run_dir, "result.md")
        if os.path.exists(res):
            sys.stdout.write(open(res).read())
    print(f"\n[antagonist] run dir: {run_dir}", file=sys.stderr)
    sys.exit(rc)


def worker(run_dir, in_thread=False, only_failed=False):
    """Execute one run. Everything is inside the try so any failure lands in
    meta.json rather than leaving the run `queued`/`running` forever.
    PRE: in_thread is set for a part of a split run; parts are CLI runs, so
    the signal-based wall-clock bound (main thread only) is not needed."""
    meta_p = os.path.join(run_dir, "meta.json")
    meta = read_json(meta_p) or {"status": "queued"}
    if meta.get("split") and not in_thread:
        return worker_split(run_dir, only_failed=only_failed)
    t0 = time.monotonic()
    secrets = None
    rc = 1
    try:
        cfg = load_config()
        secrets = Secrets(cfg)
        opts = read_json(os.path.join(run_dir, "opts.json"))
        if not opts:
            raise RuntimeError("opts.json missing or unreadable")
        prompt = open(os.path.join(run_dir, "prompt.md")).read()
        meta.update(status="running", started=now_iso(), worker_pid=os.getpid(),
                    worker_start=proc_start(os.getpid()), error=None)
        write_json(meta_p, meta)
        opts["_redact"] = secrets.redact
        backend = meta["backend"]
        # API backends: urllib's timeout is per socket operation; the alarm
        # makes --timeout a wall-clock bound. CLI backends bound and kill their
        # child in _run_cli instead.
        if backend in API_BACKENDS and not in_thread:
            signal.signal(signal.SIGALRM, _on_alarm)
            signal.alarm(int(opts["timeout"]) + 5)
        try:
            out = BACKENDS[backend](run_dir, prompt, opts)
        finally:
            if not in_thread:
                signal.alarm(0)
            # Every file the backend left in the run dir, the logs of retried
            # attempts and earlier turns included (subdirectories hold the agy
            # workspace and the parts, which redact their own files).
            for name in sorted(os.listdir(run_dir)):
                path = os.path.join(run_dir, name)
                if name not in ("meta.json", "launcher.json", "child.pid") and os.path.isfile(path):
                    secrets.redact_file(path)
        write_text_atomic(os.path.join(run_dir, "result.md"),
                          secrets.redact(out["result_text"]).rstrip() + "\n")
        extra = dict(out.get("extra") or {})
        notes = list(extra.get("notes") or [])
        if looks_truncated(out["result_text"]):
            notes.append("the answer ends inside a code block: it may be cut short")
        extra["notes"] = notes
        meta.update(status="done", model_served=out.get("model"), usage=out.get("usage"),
                    raw_status=out.get("raw_status"), extra=extra)
        rc = 0
    except Exception as exc:  # noqa: BLE001
        msg = str(exc)[:2000]
        if secrets:
            msg = secrets.redact(msg)
        meta.update(status="failed", error=msg)
    finally:
        meta.update(finished=now_iso(), duration_s=round(time.monotonic() - t0, 1))
        write_text_atomic(meta_p, json.dumps(
            _redact_obj(meta, secrets.redact) if secrets else meta, indent=2, sort_keys=True))
    return rc


def worker_split(run_dir, only_failed=False):
    """Run the parts of a split run concurrently, then merge.
    POST: `done` and result.md only when every part is done; otherwise
    `failed`, with the finished parts merged into result.partial.md."""
    meta_p = os.path.join(run_dir, "meta.json")
    meta = read_json(meta_p) or {}
    t0 = time.monotonic()
    secrets = None
    rc = 1
    try:
        secrets = Secrets(load_config())
        parts = meta["split"]["parts"]
        meta.update(status="running", started=now_iso(), worker_pid=os.getpid(),
                    worker_start=proc_start(os.getpid()), error=None)
        write_json(meta_p, meta)

        def part_meta(p):
            return read_json(os.path.join(run_dir, p["dir"], "meta.json"), {}) or {}

        todo = [p for p in parts if not (only_failed and part_meta(p).get("status") == "done")]
        with concurrent.futures.ThreadPoolExecutor(
                max_workers=max(1, int(meta["split"].get("parallel") or 6))) as ex:
            list(ex.map(lambda p: worker(os.path.join(run_dir, p["dir"]), in_thread=True), todo))
        metas = [part_meta(p) for p in parts]
        results = []
        for p, m in zip(parts, metas):
            rp = os.path.join(run_dir, p["dir"], "result.md")
            results.append(open(rp).read() if m.get("status") == "done" and os.path.exists(rp)
                           else None)
            if m.get("status") == "done" and not (results[-1] or "").strip():
                m.update(status="failed", error="recorded done, but its result.md is missing or empty")
                write_json(os.path.join(run_dir, p["dir"], "meta.json"), m)   # so retry reruns it
        usage = {}
        for m in metas:
            for k, v in (m.get("usage") or {}).items():
                if isinstance(v, (int, float)):
                    usage[k] = usage.get(k, 0) + v
        meta.update(usage=usage or None,
                    model_served=", ".join(sorted({str(m["model_served"]) for m in metas
                                                   if m.get("model_served")})) or None)
        merged = secrets.redact(merge_parts(parts, metas, results))
        final, partial = (os.path.join(run_dir, n) for n in ("result.md", "result.partial.md"))
        failed = [(i, m) for i, m in enumerate(metas, 1) if m.get("status") != "done"]
        if failed:
            if os.path.exists(final):
                os.unlink(final)
            write_text_atomic(partial, merged)
            raise RuntimeError(
                f"{len(failed)} of {len(parts)} parts failed ("
                + "; ".join(f"{i:02d}: {str(m.get('error'))[:160]}" for i, m in failed)
                + "). Finished parts are in result.partial.md")
        write_text_atomic(final, merged)
        if os.path.exists(partial):
            os.unlink(partial)
        meta.update(status="done")
        rc = 0
    except Exception as exc:  # noqa: BLE001
        msg = str(exc)[:2000]
        meta.update(status="failed", error=secrets.redact(msg) if secrets else msg)
    finally:
        if secrets:
            for name in ("worker.log", "opts.json"):   # the parts redact their own directories
                secrets.redact_file(os.path.join(run_dir, name))
        meta.update(finished=now_iso(), duration_s=round(time.monotonic() - t0, 1))
        write_text_atomic(meta_p, json.dumps(
            _redact_obj(meta, secrets.redact) if secrets else meta, indent=2, sort_keys=True))
    return rc


def is_run_dir(path):
    return os.path.isdir(path) and os.path.exists(os.path.join(path, "meta.json"))


def list_runs():
    """Run dirs oldest first, ordered by creation time, not by name (two runs
    started in the same second sort by backend name otherwise)."""
    if not os.path.isdir(RUNS_ROOT):
        return []
    entries = []
    for n in os.listdir(RUNS_ROOT):
        rd = os.path.join(RUNS_ROOT, n)
        if is_run_dir(rd):
            meta = read_json(os.path.join(rd, "meta.json"), {})
            entries.append((meta.get("created_ns") or int(os.stat(rd).st_mtime_ns), n, rd))
    return [rd for _, _, rd in sorted(entries)]


def resolve_run(arg):
    if arg in (None, "--last", "last"):
        runs = list_runs()
        if not runs:
            die("no runs yet")
        return runs[-1]
    for cand in (arg, os.path.join(RUNS_ROOT, arg)):
        if is_run_dir(cand):
            return os.path.abspath(cand)
    die(f"no such run: {arg}")


def worker_identity(run_dir, meta):
    """(pid, start) of the worker: from meta once it is running, else from the
    launcher's record."""
    if meta.get("worker_pid"):
        return meta["worker_pid"], meta.get("worker_start")
    launcher = read_json(os.path.join(run_dir, "launcher.json"), {})
    return launcher.get("worker_pid"), launcher.get("worker_start")


def describe(run_dir, meta):
    """Status with liveness: a queued or running run whose worker is gone is `died`."""
    st = meta.get("status")
    if st in ("queued", "running"):
        pid, start = worker_identity(run_dir, meta)
        if pid is not None and not pid_alive(pid, start):
            st = "died"
    return st


def orphaned_child(run_dir):
    """pgids of CLI child groups (the run's own or its parts') still alive
    after the worker died."""
    alive = []
    for pid_file in [os.path.join(run_dir, "child.pid")] + sorted(
            glob.glob(os.path.join(run_dir, "parts", "*", "child.pid"))):
        try:
            pgid = int(open(pid_file).read())
        except (OSError, ValueError):
            continue
        if _group_alive(pgid):
            alive.append(pgid)
    return alive


# Known failure strings and the fix. Matched against the error and the tail
# of stderr.log; printed by `status` as `hint:`.
HINTS = [
    (re.compile(r"sandbox failed to start", re.I),
     "agy could not start its command sandbox. `antagonist agy-check` tests it and names the "
     "likely cause (AppArmor user-namespace profile for the agy binary); or rerun with "
     "--tools read."),
    (re.compile(r"tool was denied", re.I),
     "agy refused a tool and the corrective turns did not help. `command`: agy's settings "
     "need toolPermission = proceed-in-sandbox, or rerun with --tools read. `read_file` "
     "(read mode): the path is outside --cwd; attach its directory with --read-dir."),
    (re.compile(r"parts failed", re.I),
     "`antagonist retry <run>` reruns only the failed parts and merges again."),
    (re.compile(r"exceeded the output token limit", re.I),
     "the answer outgrew agy's output cap. Rerun with --max-words (about 1500) and fewer, "
     "narrower questions; the partial draft in stdout.log is not a result."),
    (re.compile(r"cybersecurity risk|flagged for possible", re.I),
     "codex's classifier refused the framing. Rephrase as a hardening review from the "
     "owner's side (no attack/bypass wording) and rerun."),
    (re.compile(r"binary not found", re.I),
     "the backend CLI is not on PATH or in the fallback directories; `antagonist backends`."),
    (re.compile(r"went silent|incomplete", re.I),
     "the stream stalled or ended early. Rerun; at `high` rather than `max` for a "
     "long-reasoning API model."),
]


def hint_for(run_dir, error):
    tail = ""
    try:
        with open(os.path.join(run_dir, "stderr.log"), errors="replace") as fh:
            tail = fh.read()[-4000:]
    except OSError:
        pass
    for rx, text in HINTS:
        if rx.search(error or "") or rx.search(tail):
            return text
    return None


def cmd_status(args, cfg):
    run_dir = resolve_run(args.run)
    secrets = Secrets(cfg)
    meta = read_json(os.path.join(run_dir, "meta.json"), {})
    st = describe(run_dir, meta)
    print(f"run:      {run_dir}")
    print(f"status:   {st}")
    for k in ("backend", "model", "effort", "cwd", "started", "finished", "duration_s",
              "timeout_s", "idle_timeout_s"):
        print(f"{k + ':':<16}{secrets.redact(str(meta.get(k)))}")
    if meta.get("model_served"):
        print(f"served:         {secrets.redact(str(meta['model_served']))}")
    if meta.get("usage"):
        print(f"usage:          {json.dumps(meta['usage'])}")
    extra = meta.get("extra") or {}
    if extra.get("tool_calls") is not None:
        print(f"tool calls:     {json.dumps(extra['tool_calls'])}  (mode {extra.get('tools_mode')}, "
              f"attempts {extra.get('attempts')}, corrective turns {extra.get('corrective_turns')})")
    if extra.get("denied_actions"):
        print(f"denied:         {json.dumps(extra['denied_actions'])}")
    for n in extra.get("notes") or []:
        print(f"note:           {secrets.redact(str(n))}")
    for i, part in enumerate((meta.get("split") or {}).get("parts", []), 1):
        pm = read_json(os.path.join(run_dir, part["dir"], "meta.json"), {}) or {}
        pst = pm.get("status")
        if st == "died" and pst in ("queued", "running"):
            pst = "died"
        calls = (pm.get("extra") or {}).get("tool_calls")
        print(f"part {i:02d}:        {pst:<8} claims {','.join(part['claims'])}  "
              f"{pm.get('model_served') or part.get('model') or ''}  "
              f"{str(pm.get('duration_s') or '')}s"
              + (f"  tools {json.dumps(calls)}" if calls else "")
              + (f"  error: {secrets.redact(str(pm.get('error')))[:200]}" if pm.get("error") else ""))
        for n in (pm.get("extra") or {}).get("notes") or []:
            print(f"   note:        {secrets.redact(str(n))}")
    if meta.get("error"):
        print(f"error:          {secrets.redact(meta['error'])}")
        h = hint_for(run_dir, meta["error"])
        if h:
            print(f"hint:           {h}")
    if st == "died":
        for pgid in orphaned_child(run_dir):
            print(f"orphan:         the CLI child group {pgid} is still running; stop it "
                  f"before rerunning:  kill -TERM -- -{pgid}")
    if st == "running" and meta.get("started"):
        started = dt.datetime.fromisoformat(meta["started"])
        print(f"elapsed:        {int((dt.datetime.now().astimezone() - started).total_seconds())}s")
        for name in ("stderr.log", "stdout.log"):
            p = os.path.join(run_dir, name)
            if os.path.exists(p) and os.path.getsize(p):
                tail = open(p, errors="replace").read()[-600:]
                print(f"--- tail {name}\n{secrets.redact(tail)}")
    if args.wait and st in ("queued", "running"):
        # Bounded: poll every 10 s for at most --wait seconds, then return
        # with exit 3 so the caller can decide to call again.
        deadline = time.monotonic() + args.wait
        while time.monotonic() < deadline:
            time.sleep(min(10, max(0.05, deadline - time.monotonic())))
            meta = read_json(os.path.join(run_dir, "meta.json"), {})
            st = describe(run_dir, meta)
            if st not in ("queued", "running"):
                print(f"status:   {st}  ({meta.get('duration_s')}s)")
                if meta.get("error"):
                    print(f"error:    {secrets.redact(meta['error'])}")
                    h = hint_for(run_dir, meta["error"])
                    if h:
                        print(f"hint:     {h}")
                break
        else:
            print(f"status:   still {st} after {args.wait}s")
    if st in ("queued", "running"):
        sys.exit(3)
    sys.exit(0 if st == "done" else 1)


def cmd_result(args, cfg):
    run_dir = resolve_run(args.run)
    meta = read_json(os.path.join(run_dir, "meta.json"), {})
    st = describe(run_dir, meta)
    if st != "done":
        die(f"run is {st}" + (f": {Secrets(cfg).redact(meta.get('error'))}"
                             if meta.get("error") else ""), 1)
    sys.stdout.write(open(os.path.join(run_dir, "result.md")).read())


def cmd_list(args, cfg):
    secrets = Secrets(cfg)
    for rd in list_runs()[-args.n:]:
        meta = read_json(os.path.join(rd, "meta.json"), {})
        print(f"{os.path.basename(rd):<48} {describe(rd, meta):<8} "
              f"{str(meta.get('duration_s') or ''):>7}s  "
              f"{secrets.redact(str(meta.get('model_served') or meta.get('model') or ''))}")


def cmd_retry(args, cfg):
    """Rerun the failed parts of a split run and merge again."""
    run_dir = resolve_run(args.run)
    meta = read_json(os.path.join(run_dir, "meta.json"), {})
    if not meta.get("split"):
        die("retry applies to split runs; rerun a single run with `antagonist run`")
    st = describe(run_dir, meta)
    if st in ("queued", "running"):
        die(f"run is still {st}")
    if st == "done":
        die("every part is done; nothing to retry")
    orphans = orphaned_child(run_dir)
    if orphans:
        die("a backend process of this run is still running and would write into the same "
            "part directory; stop it first:  " + "  ".join(f"kill -TERM -- -{g}" for g in orphans))
    if args.detach:
        # meta is rewritten before the worker exists; the worker owns it after.
        meta.update(status="queued", worker_pid=None, error=None)
        write_json(os.path.join(run_dir, "meta.json"), meta)
        log = open(os.path.join(run_dir, "worker.log"), "ab")
        try:
            proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_worker", run_dir,
                                     "--only-failed"], stdin=subprocess.DEVNULL, stdout=log,
                                    stderr=log, start_new_session=True, close_fds=True)
        except OSError as exc:
            meta.update(status="failed", error=f"could not spawn worker: {exc}", finished=now_iso())
            write_json(os.path.join(run_dir, "meta.json"), meta)
            die(f"could not spawn worker: {exc}", 1)
        write_json(os.path.join(run_dir, "launcher.json"),
                   {"worker_pid": proc.pid, "worker_start": proc_start(proc.pid)})
        print(run_dir, flush=True)
        return
    sys.exit(worker(run_dir, only_failed=True))


AGY_CHECK_TOKEN = "antagonist-sandbox-"


def cmd_agy_check(args, cfg):
    """Functional test of the agy recipe: one model call that must run a shell
    command in agy's sandbox. Run it after agy updates itself.
    POST: exit 0 only if the command's own output shows it executed."""
    exe, _ = find_binary("agy")
    if not exe:
        die("agy: binary not found on PATH or in fallback dirs", 1)
    mode, why = agy_tools_mode("auto")
    print(f"agy binary:     {exe}")
    print(f"agy settings:   {AGY_SETTINGS}")
    print(f"tools (auto):   {mode} ({why})")
    for n in agy_environment(exe):
        print(f"warning:        {n}")
    b = cfg["agy"]
    model = (b.get("model") or "").strip() or None
    run_dir = new_run_dir("agy", "check")
    a, c = 6, 7   # the token counts only where a command's own output carries it
    prompt = (f"Run this shell command exactly once: echo {AGY_CHECK_TOKEN}$(({a}*{c}))\n"
              "Then reply with its exact output and nothing else. If it was refused or "
              "failed, quote the error.")
    write_text_atomic(os.path.join(run_dir, "prompt.md"), prompt)
    opts = {"cwd": run_dir, "model": model, "effort": norm_effort("agy", b.get("effort"), model),
            "timeout": 240, "agy_tools": "exec", "agy_web": False, "retries": 0, "read_dirs": [],
            "mask": list(b.get("mask") or [])}
    meta = {"backend": "agy", "model": model, "label": "check", "status": "running",
            "created_ns": time.time_ns(), "started": now_iso(), "worker_pid": os.getpid(),
            "worker_start": proc_start(os.getpid())}
    write_json(os.path.join(run_dir, "meta.json"), meta)
    ok, err, said = False, None, ""
    try:
        said = run_agy(run_dir, prompt, opts)["result_text"]
        # every turn's log: a corrective turn moves the earlier one to stdout.log.turnN
        ok = any(name == "run_command" and f"{AGY_CHECK_TOKEN}{a * c}" in out
                 for log in glob.glob(os.path.join(run_dir, "stdout.log*"))
                 for name, out in agy_events(run_dir, os.path.basename(log))[1])
        if not ok:
            err = "agy answered, but no command output shows the command ran"
    except RuntimeError as exc:
        err = str(exc)
    secrets = Secrets(cfg)
    for name in sorted(os.listdir(run_dir)):
        if os.path.isfile(os.path.join(run_dir, name)):
            secrets.redact_file(os.path.join(run_dir, name))
    write_text_atomic(os.path.join(run_dir, "result.md"),
                      f"agy-check: {'PASS' if ok else 'FAIL: ' + secrets.redact(str(err))}\n\n"
                      + secrets.redact(said).rstrip() + "\n")
    meta.update(status="done" if ok else "failed", error=err, finished=now_iso())
    write_json(os.path.join(run_dir, "meta.json"), _redact_obj(meta, secrets.redact))
    print(f"run dir:        {run_dir}")
    if ok:
        print("result:         PASS (a sandboxed command ran)")
        return
    print(f"result:         FAIL: {err}")
    h = hint_for(run_dir, err)
    if h:
        print(f"hint:           {h}")
    sys.exit(1)


def cmd_agy_allow(args, cfg):
    """Add a read_file grant for DIR to agy's settings.json (backup first).
    Runs no longer need it: the review directory is attached per run.
    PRE: agy has no `config set`; the file is the only write path.
    POST: `agy -p /permissions` lists the grant."""
    path = AGY_SETTINGS
    if not os.path.exists(path):
        die(f"{path} missing; run agy once interactively first")
    d = read_json(path)
    if d is None:
        die(f"{path} is not valid JSON")
    target = os.path.abspath(args.dir).rstrip("/") + "/"
    grant = f"read_file({target})"
    allow = d.setdefault("permissions", {}).setdefault("allow", [])
    if grant in allow:
        print(f"already present: {grant}")
        return
    bak = path + ".bak-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.copy2(path, bak)
    allow.append(grant)
    write_json(path, d)
    print(f"added {grant}\nbackup: {bak}\nverify: agy -p /permissions")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="antagonist", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="run a review")
    r.add_argument("--backend", "-b", choices=list(BACKENDS))
    r.add_argument("--prompt-file", "-f")
    r.add_argument("--prompt", "-p")
    r.add_argument("--evidence", "-e", action="append", default=[],
                   help="file to paste verbatim (repeatable; relative paths resolve against --cwd)")
    r.add_argument("--cwd", help="review workspace for CLI backends (default: current dir)")
    r.add_argument("--effort", choices=EFFORTS)
    r.add_argument("--model")
    r.add_argument("--timeout", type=int, help="wall-clock seconds (default from config, 3600)")
    r.add_argument("--idle-timeout", type=int,
                   help="API backends: max seconds of stream silence (default 300)")
    r.add_argument("--label", help="suffix for the run directory name")
    r.add_argument("--detach", "-d", action="store_true",
                   help="start in the background and print the run dir")
    r.add_argument("--no-preamble", action="store_true",
                   help="send the prompt file as-is, without the reviewer preamble")
    r.add_argument("--no-fallbacks", action="store_true",
                   help="anthropic: do not request server-side refusal fallbacks")
    r.add_argument("--allow-secrets", action="store_true",
                   help="run even if the prompt matches a credential pattern (known values still refuse)")
    r.add_argument("--quiet", "-q", action="store_true", help="do not print the result")
    r.add_argument("--max-words", type=int, metavar="N",
                   help="append a word budget to the task (per part under --split)")
    r.add_argument("--split", metavar="SPEC",
                   help="one run per group of claims, in parallel, merged into one result: "
                        "`auto` (3 claims per part), `auto:N`, or groups like `1,2/3,4,7/*` "
                        "(`*` = every claim not named). CLI backends only")
    r.add_argument("--also-model", action="append", default=[], metavar="MODEL",
                   help="with --split: run every part on this model as well (repeatable)")
    r.add_argument("--tools", choices=["auto", "read", "exec"],
                   help="agy: read = search and read files; exec = also sandboxed shell "
                        "(default auto: exec when agy's settings allow it)")
    r.add_argument("--read-dir", action="append", default=[], metavar="DIR",
                   help="agy: another directory the reviewer may read (repeatable; --cwd is always readable)")
    r.add_argument("--no-preflight", action="store_true",
                   help="skip the harness/model currency check (also: ANTAGONIST_NO_PREFLIGHT=1)")
    r.add_argument("--refresh", action="store_true", help="refetch the currency check, ignoring the cache")
    r.add_argument("--strict", action="store_true",
                   help="refuse to run when the currency check has any note")
    r.set_defaults(fn=cmd_run)

    b = sub.add_parser("backends", help="show backend availability, defaults, and currency notes")
    b.add_argument("--refresh", action="store_true", help="refetch the currency check")
    b.add_argument("--no-preflight", action="store_true", help="skip the currency check")
    b.set_defaults(fn=cmd_backends)

    pf = sub.add_parser("preflight", help="harness versions and model catalogs vs the pinned defaults")
    pf.add_argument("--refresh", action="store_true", help="refetch, ignoring the cache")
    pf.set_defaults(fn=cmd_preflight)

    s = sub.add_parser("status", help="status of a run (default: last)")
    s.add_argument("run", nargs="?")
    s.add_argument("--wait", type=int, metavar="SECS",
                   help="poll for up to SECS seconds; exit 3 if still running")
    s.set_defaults(fn=cmd_status)

    g = sub.add_parser("result", help="print a finished run's result (default: last)")
    g.add_argument("run", nargs="?")
    g.set_defaults(fn=cmd_result)

    l = sub.add_parser("list", help="recent runs")
    l.add_argument("-n", type=int, default=20)
    l.set_defaults(fn=cmd_list)

    rt = sub.add_parser("retry", help="rerun the failed parts of a split run (default: last)")
    rt.add_argument("run", nargs="?")
    rt.add_argument("--detach", "-d", action="store_true")
    rt.set_defaults(fn=cmd_retry)

    ac = sub.add_parser("agy-check", help="test that agy can run a sandboxed command (one model call)")
    ac.set_defaults(fn=cmd_agy_check)

    a = sub.add_parser("agy-allow", help="add a standing agy read grant (not needed for runs)")
    a.add_argument("dir")
    a.set_defaults(fn=cmd_agy_allow)

    w = sub.add_parser("_worker")
    w.add_argument("run_dir")
    w.add_argument("--only-failed", action="store_true")
    w.set_defaults(fn=lambda args, cfg: sys.exit(worker(args.run_dir, only_failed=args.only_failed)))

    args = ap.parse_args(argv)
    cfg = load_config()
    args.fn(args, cfg)


if __name__ == "__main__":
    main()
