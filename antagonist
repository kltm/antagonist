# --------------------------------------------------------------------- utils

def die(msg, code=2):
    print(f"antagonist: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))  # deep copy
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, "rb") as fh:
            user = tomllib.load(fh)
        for k, v in user.items():
            if isinstance(v, dict) and isinstance(cfg.get(k), dict):
                cfg[k].update(v)
            else:
                cfg[k] = v
    for name in API_BACKENDS:
        if cfg[name].get("key_file"):
            cfg[name]["key_file"] = os.path.expanduser(cfg[name]["key_file"])
        cfg[name]["base_url"] = (cfg[name].get("base_url") or "").rstrip("/")
    # The Anthropic path is appended as /v1/messages; a base_url that already
    # ends in /v1 would double it.
    if cfg["anthropic"]["base_url"].endswith("/v1"):
        cfg["anthropic"]["base_url"] = cfg["anthropic"]["base_url"][:-3]
    return cfg


# Only an UPPER_CASE shell identifier counts as an assignment; a bare token
# such as `abc=def==` is kept whole.
_ASSIGN_RE = re.compile(r"^(?:export\s+)?[A-Z][A-Z0-9_]*=(.*)$")


def read_key_file(path):
    """Accept a raw token, `KEY=value`, or `export KEY=value`. Never echo it."""
    if not path or not os.path.exists(path):
        return None
    with open(path) as fh:
        raw = fh.read().strip()
    line = raw.splitlines()[0].strip() if raw else ""
    m = _ASSIGN_RE.match(line)
    if m:
        line = m.group(1).strip()
    return line.strip("'\"") or None


class Secrets:
    """Known credential values, for redaction and prompt refusal. In memory only."""

    def __init__(self, cfg):
        vals = set()
        for name in API_BACKENDS:
            v = read_key_file(cfg[name].get("key_file"))
            if v:
                vals.add(v)
        for k, v in os.environ.items():
            if ENV_SECRET_RE.search(k) and len(v) >= 8:
                vals.add(v)
        self.values = sorted(vals, key=len, reverse=True)

    def redact(self, text):
        if not text:
            return text
        for v in self.values:
            text = text.replace(v, "<redacted>")
        return text

    def redact_file(self, path):
        if not os.path.exists(path) or not self.values:
            return
        with open(path, "rb") as fh:
            data = fh.read()
        new = data
        for v in self.values:
            new = new.replace(v.encode(), b"<redacted>")
        if new != data:
            with open(path, "wb") as fh:
                fh.write(new)


def child_env():
    """Environment for CLI children: secret-looking variables removed."""
    env = {}
    for k, v in os.environ.items():
        if k in ENV_KEEP or not ENV_SECRET_RE.search(k):
            env[k] = v
    return env


def scan_for_secrets(text, secrets):
    """Return [(line_no, label)] for credential shapes or known values. No text."""
    hits = []
    for i, line in enumerate(text.splitlines(), 1):
        for v in secrets.values:
            if v in line:
                hits.append((i, "known credential value"))
                break
        else:
            for label, rx in SECRET_PATTERNS:
                if rx.search(line):
                    hits.append((i, label))
                    break
    return hits


def guess_lang(path):
    ext = os.path.splitext(path)[1].lower()
    return {
        ".py": "python", ".sh": "bash", ".bash": "bash", ".js": "javascript",
        ".ts": "typescript", ".json": "json", ".yaml": "yaml", ".yml": "yaml",
        ".toml": "toml", ".tf": "hcl", ".md": "markdown", ".conf": "apache",
        ".cfg": "ini", ".ini": "ini", ".sql": "sql", ".rb": "ruby", ".go": "go",
        ".rs": "rust", ".txt": "", ".diff": "diff", ".patch": "diff",
    }.get(ext, "")


def fence_for(text):
    longest = max((len(m) for m in re.findall(r"`{3,}", text)), default=0)
    return "`" * max(3, longest + 1)


_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def has_visible_text(s):
    """True if s contains a character that would render: not whitespace, not a
    control/format/zero-width character, not an ANSI escape."""
    s = _ANSI_RE.sub("", s or "")
    return any(not ch.isspace() and unicodedata.category(ch) not in ("Cc", "Cf", "Zs", "Zl", "Zp")
               for ch in s)


def resolve_evidence(cwd, paths):
    """Relative evidence paths resolve against the review workspace, not the
    directory the command happens to run from."""
    out = []
    for p in paths:
        ap = os.path.abspath(p if os.path.isabs(p) else os.path.join(cwd, p))
        if not os.path.isfile(ap):
            die(f"evidence not found: {ap}")
        out.append(ap)
    return out


def read_evidence(path):
    """Bytes in, exact text out: strict UTF-8, newlines untouched."""
    with open(path, "rb") as fh:
        data = fh.read()
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ValueError(f"{path} is not valid UTF-8 at byte {exc.start}; "
                         "evidence must be text") from None
    return text, len(data)


def assemble_prompt(task_text, evidence, backend, cwd, preamble=True):
    """`evidence` is a list of absolute paths. With preamble=False the task
    text goes through unchanged (no heading, no trimming); evidence, if any,
    is still appended."""
    parts = []
    if preamble:
        parts.append(PREAMBLE)
        if backend in CLI_NOTE:
            parts.append(CLI_NOTE[backend].format(cwd=cwd) + "\n")
        parts.append("# Task\n\n" + task_text.rstrip() + "\n")
    else:
        parts.append(task_text)
    if evidence:
        parts.append("# Evidence\n")
        for ap in evidence:
            body, nbytes = read_evidence(ap)
            fence = fence_for(body)
            if not body.endswith("\n"):
                body += "\n"
            parts.append(f"## `{ap}` ({nbytes} bytes)\n\n"
                         f"{fence}{guess_lang(ap)}\n{body}{fence}\n")
    return "\n".join(parts)


def norm_effort(backend, effort, model):
    """Map the shared low..max scale onto what each backend accepts."""
    if effort is None:
        return None
    if effort not in EFFORTS:
        die(f"--effort must be one of {', '.join(EFFORTS)}")
    if backend in ("codex", "claude", "anthropic"):
        return effort
    if backend == "agy":
        return {"low": "low", "medium": "medium", "high": "high",
                "xhigh": "high", "max": "high"}[effort]
    if backend == "moonshot":
        if model and re.match(r"^kimi-k3(?:$|-)", model):
            # kimi-k3 has low|high|max; medium rounds up, not down.
            return {"low": "low", "medium": "high", "high": "high",
                    "xhigh": "max", "max": "max"}[effort]
        return None
    return None


def fsync_path(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


_UMASK = os.umask(0)
os.umask(_UMASK)


def write_text_atomic(path, text, mode=None):
    """Unique temp file in the same directory (concurrent writers cannot share
    one), created at its final mode (umask-applied 0666 unless given), fsynced,
    renamed over path. A failure removes the temp file."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as fh:   # owns fd from here, so a chmod failure cannot leak it
            os.fchmod(fh.fileno(), mode if mode is not None else (0o666 & ~_UMASK))
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    fsync_path(d)


def write_json(path, obj):
    write_text_atomic(path, json.dumps(obj, indent=2, sort_keys=True))


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):   # ValueError covers JSONDecodeError and bad UTF-8
        return default


def proc_start(pid):
    """Linux process start time (clock ticks since boot) from /proc, or None."""
    try:
        with open(f"/proc/{pid}/stat") as fh:
            return int(fh.read().rsplit(")", 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def pid_alive(pid, start=None):
    """Liveness with same-boot pid-reuse protection when a start time is known."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    if start is not None:
        return proc_start(pid) == start
    return True


class WallClockTimeout(RuntimeError):
    pass


def _on_alarm(signum, frame):
    raise WallClockTimeout("wall-clock timeout")


# ------------------------------------------------------------------ backends
# Each backend: run_<name>(run_dir, prompt, opts) -> dict(result_text, usage,
# model, raw_status, extra). Raises RuntimeError on failure with a message.

def find_binary(name):
    """(path, on_path). Off-PATH hits come from FALLBACK_BIN_DIRS, newest nvm
    version first."""
    exe = shutil.which(name)
    if exe:
        return os.path.abspath(exe), True   # PATH may hold "." : pin the file we checked
    for pat in FALLBACK_BIN_DIRS:
        # newest version first: v20.20.0 before v9.0.0, which a plain sort inverts
        dirs = sorted(glob.glob(pat), reverse=True,
                      key=lambda p: parse_version(os.path.basename(os.path.dirname(p))) or (0,))
        for d in dirs:
            cand = os.path.join(d, name)
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                return cand, False
    return None, False


def _cli_env(exe, on_path):
    """child_env, with the binary's own directory first on PATH when it was
    found off PATH (an npm shim needs the node next to it)."""
    env = child_env()
    if not on_path:
        env["PATH"] = os.path.dirname(exe) + os.pathsep + (env.get("PATH") or os.defpath)
    return env


def _run_cli(run_dir, argv, stdin_text, cwd, timeout, stdin_name="prompt.md"):
    """Run a CLI backend in its own process group with a wall-clock bound.
    PRE: stdin_text is what goes to the child's stdin; when it is not the
    assembled prompt it is saved under stdin_name so cmd.txt reproduces it.
    POST: on timeout the whole process group gets SIGTERM, then SIGKILL after
    10 s regardless of whether the direct child already exited. Processes that
    left the group (their own setsid) are out of reach; that is the scope."""
    if os.path.isabs(argv[0]):
        exe, on_path = argv[0], True
    else:
        exe, on_path = find_binary(argv[0])
        if not exe:
            raise RuntimeError(f"{argv[0]}: binary not found on PATH or in fallback dirs")
        argv = [exe] + list(argv[1:])   # the file that was checked is the file that runs
    env = _cli_env(exe, on_path)
    if stdin_name != "prompt.md":
        with open(os.path.join(run_dir, stdin_name), "w") as fh:
            fh.write(stdin_text)
    with open(os.path.join(run_dir, "cmd.txt"), "w") as fh:
        fh.write(f"cd {shlex.quote(cwd)} && " + " ".join(shlex.quote(a) for a in argv)
                 + f" < {stdin_name}\n")
    out_p = os.path.join(run_dir, "stdout.log")
    err_p = os.path.join(run_dir, "stderr.log")
    with open(out_p, "wb") as out, open(err_p, "wb") as err:
        proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE, stdout=out,
                                stderr=err, start_new_session=True, env=env)
        with open(os.path.join(run_dir, "child.pid"), "w") as fh:
            fh.write(str(proc.pid))
        try:
            proc.communicate(stdin_text.encode(), timeout=timeout)
        except subprocess.TimeoutExpired:
            _kill_group(proc)
            raise RuntimeError(f"timed out after {timeout}s")
        except BaseException:
            # Ctrl-C or a signal to a foreground run: do not orphan the child
            # (it is in its own session and would keep running and billing).
            _kill_group(proc)
            raise
    if _group_alive(proc.pid):
        # The child exited but left something in its group: clean it up.
        _kill_group(proc)
    return proc.returncode


def _group_alive(pgid):
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    return True


def _kill_group(proc):
    """SIGTERM the group, give the whole group (not just the direct child)
    a grace period, then SIGKILL whatever is left and reap the child."""
    for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            try:
                proc.wait(0.2)
            except subprocess.TimeoutExpired:
                pass
            if proc.poll() is not None and not _group_alive(proc.pid):
                return
            time.sleep(0.2)
    try:
        proc.wait(1)
    except subprocess.TimeoutExpired:
        pass


def run_codex(run_dir, prompt, o):
    last = os.path.join(run_dir, "result.raw.md")
    if os.path.exists(last):
        os.unlink(last)   # never accept a stale final message
    argv = ["codex", "exec", "-", "-s", "read-only", "-C", o["cwd"],
            "--ephemeral", "--color", "never", "-o", last,
            "-c", "project_doc_max_bytes=0"]   # no AGENTS.md in the reviewer's context
    if o["effort"]:
        argv += ["-c", f"model_reasoning_effort={o['effort']}"]
    if o["model"]:
        argv += ["-m", o["model"]]
    cfg_model = codex_defaults()   # read before launch: what the CLI was configured with
    rc = _run_cli(run_dir, argv, prompt, o["cwd"], o["timeout"])
    if rc != 0:
        raise RuntimeError(f"codex exec exited {rc}; see stderr.log")
    text = open(last).read() if os.path.exists(last) else ""
    if not text.strip():
        raise RuntimeError("codex exited 0 but wrote no final message (result.raw.md empty)")
    # codex reports no served model; the config default is evidence of the
    # request, not of what was served, so it goes under extra.
    return {"result_text": text, "usage": None, "model": o["model"] or "(codex default)",
            "raw_status": f"exit {rc}", "extra": {"codex_config_at_launch": cfg_model}}


AGY_PRO_RE = re.compile(r"^(gemini-[\d.]+-pro)(?:-(low|medium|high))?$")
_AGY_ERROR_RE = re.compile(r"AGY_ERROR:\s*(\{.*\})")


def _agy_short_error(run_dir):
    """': <first line of agy's own short_error>' from stderr.log, or ''."""
    try:
        text = open(os.path.join(run_dir, "stderr.log"), errors="replace").read()
    except OSError:
        return ""
    for m in reversed(_AGY_ERROR_RE.findall(text)):
        try:
            short = (json.loads(m).get("short_error") or "").strip().splitlines()
        except ValueError:
            continue
        if short:
            return ": " + short[0][:200]
    return ""


def run_agy(run_dir, prompt, o):
    model, effort = o["model"], o["effort"]
    argv = ["agy", "-p", "", "--input-format", "stream-json",
            "--output-format", "stream-json", "--sandbox",
            "--print-timeout", f"{max(60, o['timeout'])}s"]
    effective = effort
    m = AGY_PRO_RE.match(model or "")
    if m:
        # Pro models carry effort in the slug and offer only low|high.
        eff = effort or m.group(2) or "high"
        eff = "high" if eff == "medium" else eff
        model, effective = f"{m.group(1)}-{eff}", eff
    elif effort:
        argv += ["--effort", effort]
    if model:
        argv += ["--model", model]
    line = json.dumps({"event": "user", "message": {"content": prompt}}) + "\n"
    rc = _run_cli(run_dir, argv, line, o["cwd"], o["timeout"] + 30,
                  stdin_name="prompt.agy.jsonl")
    result = None
    with open(os.path.join(run_dir, "stdout.log"), errors="replace") as fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                ev = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if ev.get("event") == "result":
                result = ev["result"]
    if rc != 0:
        raise RuntimeError(f"agy exited {rc}{_agy_short_error(run_dir)}; see stderr.log")
    if result is None:
        raise RuntimeError("agy produced no result event; see stdout.log/stderr.log")
    if result.get("status") != "SUCCESS":
        raise RuntimeError(f"agy status {result.get('status')}: {result.get('error')}")
    if not (result.get("response") or "").strip():
        # SUCCESS with an empty response is agy's shape for a soft-denied tool.
        note = open(os.path.join(run_dir, "stderr.log"), errors="replace").read().strip()
        raise RuntimeError("agy returned an empty response (a tool was denied in headless "
                           f"mode): {note.splitlines()[0][:300] if note else 'no stderr'}")
    return {"result_text": result["response"], "usage": result.get("usage"),
            "model": model or "(agy default)", "raw_status": result.get("status"),
            "extra": {"conversation_id": result.get("conversation_id"),
                      "num_turns": result.get("num_turns"), "effective_effort": effective}}


def run_claude(run_dir, prompt, o):
    # --safe-mode drops CLAUDE.md, hooks, plugins, MCP, skills; plan mode plus a
    # read-only tool list keeps it from editing. --bare is not used: it skips
    # the credential store and the run fails with "Not logged in".
    argv = ["claude", "-p", "--output-format", "json", "--permission-mode", "plan",
            "--tools", "Read,Grep,Glob", "--no-session-persistence",
            "--safe-mode", "--strict-mcp-config", "--disable-slash-commands"]
    if o["effort"]:
        argv += ["--effort", o["effort"]]
    if o["model"]:
        argv += ["--model", o["model"]]
    rc = _run_cli(run_dir, argv, prompt, o["cwd"], o["timeout"])
    raw = open(os.path.join(run_dir, "stdout.log"), errors="replace").read()
    try:
        d = json.loads(raw)
    except json.JSONDecodeError:
        raise RuntimeError(f"claude -p output was not JSON (exit {rc}); see stdout.log")
    if rc != 0:
        raise RuntimeError(f"claude -p exited {rc}: {str(d.get('result'))[:300]}")
    if d.get("is_error"):
        raise RuntimeError(f"claude -p error: {str(d.get('result'))[:300]}")
    if not (d.get("result") or "").strip():
        raise RuntimeError("claude -p returned an empty result")
    return {"result_text": d["result"], "usage": d.get("usage"),
            "model": ",".join((d.get("modelUsage") or {}).keys()) or o["model"] or "(claude default)",
            "raw_status": d.get("subtype"),
            "extra": {"num_turns": d.get("num_turns"), "total_cost_usd": d.get("total_cost_usd"),
                      "duration_ms": d.get("duration_ms")}}


class RedirectRefused(RuntimeError):
    """Raised instead of following a redirect on an authenticated request. The
    message names the target; it is response-controlled, so callers that
    record errors must keep the class, not the text."""


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise RedirectRefused(f"refusing to follow HTTP {code} redirect to {newurl}")


def _check_endpoint(base_url, authenticated):
    parts = urllib.parse.urlsplit(base_url)
    if authenticated and parts.scheme != "https" and parts.hostname not in (
            "127.0.0.1", "localhost", "::1"):
        raise RuntimeError(f"refusing to send a credential over plain http to {base_url}")


_CREDIT_TOKEN_RE = re.compile(r'("fallback_credit_token"\s*:\s*")[^"]*(")')


def _sse_post(url, headers, body, idle_timeout, log_path, on_event, redact=lambda s: s):
    """POST and stream SSE. Writes each line to log_path after `redact` and
    after scrubbing response-issued tokens. Returns True if the server ended
    the stream with `[DONE]`, else False (plain EOF). Any `data:` payload that
    is not valid JSON fails the run: a damaged stream is not a review.
    `idle_timeout` bounds silence per socket read; the worker's alarm bounds
    the wall clock."""
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                 headers={"Content-Type": "application/json", **headers})
    opener = urllib.request.build_opener(_NoRedirect)
    try:
        resp = opener.open(req, timeout=idle_timeout)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:1000]
        raise RuntimeError(f"HTTP {exc.code} from {url}: {detail}")
    except TimeoutError:
        raise RuntimeError(f"no response from {url} within idle timeout {idle_timeout}s")
    done_marker = False
    event_name = None
    malformed = 0
    with resp, open(log_path, "w") as log:
        while True:
            try:
                raw = resp.readline()
            except TimeoutError:
                raise RuntimeError(f"stream from {url} went silent for {idle_timeout}s")
            if not raw:
                break
            try:
                line = raw.decode("utf-8").rstrip("\r\n")
            except UnicodeDecodeError:
                malformed += 1
                log.write("<undecodable line>\n")
                continue
            log.write(redact(_CREDIT_TOKEN_RE.sub(r"\1<redacted>\2", line)) + "\n")
            if line.startswith("event:"):
                event_name = line[6:].strip()
            elif line.startswith("data:"):
                data = line[5:].strip()
                if data == "[DONE]":
                    done_marker = True
                    break
                try:
                    payload = json.loads(data)
                except json.JSONDecodeError:
                    malformed += 1
                    continue
                on_event(event_name, payload)
            elif line == "":
                event_name = None
    if malformed:
        raise RuntimeError(f"stream carried {malformed} malformed line(s); response not trusted")
    return done_marker


def run_anthropic(run_dir, prompt, o):
    key = read_key_file(o["key_file"]) or os.environ.get("ANTHROPIC_API_KEY")
    if not key:
        raise RuntimeError("no API key: set key_file in config or ANTHROPIC_API_KEY")
    _check_endpoint(o["base_url"], True)
    body = {
        "model": o["model"], "max_tokens": int(o["max_tokens"]), "stream": True,
        "thinking": {"type": "adaptive", "display": "omitted"},
        "messages": [{"role": "user", "content": prompt}],
    }
    if o["effort"]:
        body["output_config"] = {"effort": o["effort"]}
    headers = {"x-api-key": key, "anthropic-version": "2023-06-01"}
    if o.get("fallbacks"):
        body["fallbacks"] = "default"
        headers["anthropic-beta"] = "server-side-fallback-2026-07-01"
    _write_api_cmd(run_dir, f"{o['base_url']}/v1/messages", body,
                   "anthropic-version, x-api-key: <redacted>"
                   + (", anthropic-beta: " + headers["anthropic-beta"]
                      if "anthropic-beta" in headers else ""))
    text, thinking = [], []
    st = {"model": None, "stop_reason": None, "usage": {}, "fallbacks": [],
          "stop_details": None, "message_start": False, "message_stop": False}

    def on_event(name, d):
        t = d.get("type")
        if t == "message_start":
            st["message_start"] = True
            st["model"] = d["message"].get("model")
            st["usage"].update(d["message"].get("usage") or {})
        elif t == "content_block_start":
            cb = d.get("content_block", {})
            if cb.get("type") == "fallback":
                st["fallbacks"].append(cb)
                st["model"] = (cb.get("to") or {}).get("model") or st["model"]
        elif t == "content_block_delta":
            delta = d.get("delta", {})
            if delta.get("type") == "text_delta":
                text.append(delta.get("text", ""))
            elif delta.get("type") == "thinking_delta":
                thinking.append(delta.get("thinking", ""))
        elif t == "message_delta":
            delta = d.get("delta", {})
            st["stop_reason"] = delta.get("stop_reason")
            st["stop_details"] = delta.get("stop_details")
            st["usage"].update(d.get("usage") or {})
        elif t == "message_stop":
            st["message_stop"] = True
        elif t == "error":
            raise RuntimeError(f"API stream error: {json.dumps(d)[:500]}")

    _sse_post(f"{o['base_url'].rstrip('/')}/v1/messages", headers, body,
              o["idle_timeout"], os.path.join(run_dir, "stdout.log"), on_event,
              redact=o.get("_redact", lambda s: s))
    if not (st["message_start"] and st["message_stop"] and st["stop_reason"]):
        raise RuntimeError("stream incomplete: needs message_start, message_delta with a "
                           f"stop_reason, and message_stop (got stop_reason={st['stop_reason']}, "
                           f"start={st['message_start']}, stop={st['message_stop']})")
    if st["stop_reason"] == "refusal":
        details = dict(st["stop_details"] or {})
        details.pop("fallback_credit_token", None)   # a capability, never persisted
        raise RuntimeError(f"model refused: {json.dumps(details)}")
    body_text = "".join(text)
    if not has_visible_text(body_text):
        raise RuntimeError(f"no visible text in response (stop_reason={st['stop_reason']})")
    if st["stop_reason"] in ("max_tokens", "model_context_window_exceeded"):
        body_text += f"\n\n[antagonist: output truncated: stop_reason={st['stop_reason']}]"
    if any(thinking):
        with open(os.path.join(run_dir, "reasoning.md"), "w") as fh:
            fh.write("".join(thinking))
    iter_fallback = any((it or {}).get("type") == "fallback_message"
                        for it in (st["usage"].get("iterations") or []))
    return {"result_text": body_text, "usage": st["usage"], "model": st["model"],
            "raw_status": st["stop_reason"],
            "extra": {"requested_model": o["model"], "fallbacks": st["fallbacks"],
                      "served_by_fallback": bool(st["fallbacks"]) or iter_fallback}}


def _write_api_cmd(run_dir, url, body, header_note):
    redacted = dict(body)
    redacted["messages"] = "[prompt.md]"
    with open(os.path.join(run_dir, "cmd.txt"), "w") as fh:
        fh.write(f"POST {url}\nheaders: {header_note}\n" + json.dumps(redacted, indent=2) + "\n")
    open(os.path.join(run_dir, "stderr.log"), "w").close()


def run_openai_compat(run_dir, prompt, o, provider):
    key = read_key_file(o["key_file"]) if o.get("key_file") else None
    if provider == "moonshot" and not key:
        key = os.environ.get("MOONSHOT_API_KEY")
        if not key:
            raise RuntimeError("no API key: set key_file in config or MOONSHOT_API_KEY")
    model = (o["model"] or "").strip()
    if not model:
        raise RuntimeError(f"{provider}: --model is required (no default)")
    _check_endpoint(o["base_url"], bool(key))
    body = {"model": model, "stream": True,
            "messages": [{"role": "user", "content": prompt}],
            "stream_options": {"include_usage": True}}
    # Moonshot documents max_completion_tokens; ollama documents max_tokens.
    body["max_completion_tokens" if provider == "moonshot" else "max_tokens"] = int(o["max_tokens"])
    if o["effort"]:
        body["reasoning_effort"] = o["effort"]
    headers = {"Authorization": f"Bearer {key}"} if key else {}
    _write_api_cmd(run_dir, f"{o['base_url']}/chat/completions", body,
                   "Authorization: Bearer <redacted>" if key else "(none)")
    text, reasoning = [], []
    st = {"model": None, "finish": None, "usage": None}

    def on_event(_name, d):
        if d.get("error"):
            raise RuntimeError(f"API error: {json.dumps(d)[:500]}")
        st["model"] = d.get("model") or st["model"]
        if d.get("usage"):
            st["usage"] = d["usage"]
        for ch in d.get("choices") or []:
            delta = ch.get("delta") or {}
            if delta.get("content"):
                text.append(delta["content"])
            if delta.get("reasoning_content"):
                reasoning.append(delta["reasoning_content"])
            if ch.get("finish_reason"):
                st["finish"] = ch["finish_reason"]

    done = _sse_post(f"{o['base_url'].rstrip('/')}/chat/completions", headers, body,
                     o["idle_timeout"], os.path.join(run_dir, "stdout.log"), on_event,
                     redact=o.get("_redact", lambda s: s))
    if reasoning:
        with open(os.path.join(run_dir, "reasoning.md"), "w") as fh:
            fh.write("".join(reasoning))
    if not done and not st["finish"]:
        raise RuntimeError("stream ended without [DONE] or a finish_reason; response incomplete")
    if st["finish"] not in (None, "stop", "length"):
        raise RuntimeError(f"finish_reason={st['finish']}")
    body_text = "".join(text)
    if not has_visible_text(body_text):
        raise RuntimeError(f"no visible text in response (finish_reason={st['finish']})")
    if st["finish"] == "length":
        body_text += "\n\n[antagonist: output truncated at max tokens]"
    return {"result_text": body_text, "usage": st["usage"], "model": st["model"],
            "raw_status": st["finish"] or "[DONE]"}


